<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- SDD app-auto-update: sideloaded APK install via DownloadManager + install intent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NextPageApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="NextPage"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NextPage">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NextPage.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase OAuth callback deep-link -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="nextpage"
                    android:host="auth"
                    android:pathPrefix="/callback" />

                <!-- Password-reset email link (Supabase resetPasswordForEmail
                     redirectUrl = nextpage://auth/reset-password). The app
                     resolves this cold-start and lands on the forgot screen. -->
                <data
                    android:scheme="nextpage"
                    android:host="auth"
                    android:pathPrefix="/reset-password" />

                <!-- Email-confirmation deep link (Supabase Site URL
                     nextpage://auth/confirm). supabase-kt's handleDeeplinks
                     parses the fragment and imports the signup session. -->
                <data
                    android:scheme="nextpage"
                    android:host="auth"
                    android:pathPrefix="/confirm" />

            <!-- Addon install deep link (addon-deeplink-v1): routed by
                 MainActivity BEFORE supabase handleDeeplinks. Custom scheme -
                 no assetlinks.json needed. -->
            <data
                android:scheme="nextpage"
                android:host="install" />
            </intent-filter>

            <!-- Google Drive OAuth redirect (authorization-code + PKCE).
                 Scheme injected from build.gradle.kts (driveRedirectScheme) —
                 Google's reserved native-app pattern
                 com.googleusercontent.apps.<android-client-id>:/oauth2redirect.
                 Arbitrary custom URI schemes are no longer supported on Android. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="${driveRedirectScheme}"
                    android:pathPrefix="/oauth2redirect" />
            </intent-filter>
        </activity>

        <activity
            android:name=".debug.CrashDetailActivity"
            android:exported="false" />

        <!-- Crash feedback sheet host (PR4 / tasks 4.3-4.4). Launched by MainActivity
             when a pending crash has a persisted Sentry eventId (next-launch prompt)
             and from CrashDetailActivity on the in-app KEY_LAST_CRASH path. Not
             exported — no external entity needs to start this activity. -->
        <activity
            android:name=".debug.FeedbackActivity"
            android:exported="false"
            android:theme="@style/Theme.NextPage.Splash" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager on-demand initialization (S6). NextPageApplication
             implements Configuration.Provider + HiltWorkerFactory, so the
             default androidx.startup WorkManagerInitializer MUST be removed —
             otherwise the default Configuration wins and the Hilt worker
             factory is never used. Merge into the library-declared
             InitializationProvider and remove ONLY WorkManagerInitializer
             (not the whole provider) so other startup initializers such as
             ProfileInstaller keep running. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Disable Sentry's auto-init ContentProvider (SentryInitProvider).
             We init manually in NextPageApplication.onCreate with the DSN
             from BuildConfig (local.properties, gitignored). Without this,
             the provider crashes on launch with "DSN is required" when no
             DSN is set via manifest meta-data. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
    </application>

</manifest>
