<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A3: default for every destination that is not named below.

         HTTPS only. All three backends the app talks to (Supabase, Google
         Drive/Books, the public catalogs) are HTTPS endpoints, so a cleartext
         fallback here would only ever serve a downgrade, a redirect or a
         misconfigured proxy. Setting the default instead of relying on the
         platform's per-version `usesCleartextTraffic` default keeps the rule
         identical on every Android version from the minSdk up.

         Debug builds are NOT exempted: `app/src/debug` ships no
         `network_security_config.xml`, so a local cleartext endpoint needs its
         own `domain-config` added deliberately rather than granted here. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Google Drive API requires HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
    </domain-config>
    <!-- Discover catalog (PR2): public-domain book sources, HTTPS-only.
         covers.openlibrary.org is covered by the openlibrary.org entry.
         No new permissions: INTERNET already declared in the manifest. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">gutendex.com</domain>
        <domain includeSubdomains="true">openlibrary.org</domain>
        <domain includeSubdomains="true">archive.org</domain>
        <!-- U2: Google Books volumes API (HTTPS-only; googleapis.com entry
             above already covers it via includeSubdomains, listed explicitly
             so the allowlist is auditable). -->
        <domain includeSubdomains="true">books.googleapis.com</domain>
        <domain includeSubdomains="true">www.googleapis.com</domain>
    </domain-config>
</network-security-config>
