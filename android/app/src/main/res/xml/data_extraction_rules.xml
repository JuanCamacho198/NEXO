<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ backup surface. `android:allowBackup="false"` and
    `android:fullBackupContent="false"` already opt out of the pre-31 path, but
    from Android 12 the cloud-backup and device-transfer paths are configured
    here instead. Both are denied explicitly so neither is merely undefined:
    - cloud-backup: nothing leaves the device to Google Drive;
    - device-transfer: nothing moves to a new device over cable or Wi-Fi.

    Every domain is excluded at the root so the denial does not depend on which
    paths the platform decides to enumerate.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
