<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. Placed in `mipmap-anydpi` rather than the historical
     `mipmap-anydpi-v26`: minSdk is 26, so the `-v26` qualifier is dead weight
     (lint ObsoleteSdkInt) and `anydpi` already outranks every density bucket, so
     all supported devices resolve this file.

     - background: the brand tile's warm gradient (@drawable/ic_launcher_background),
       full-bleed 512x512. A launcher masks this layer to its own shape, so the
       tile IS the icon body on every mask.
     - foreground: the bookmark ribbon with the "N" knocked out, no tile and no
       wordmark, scaled to 78% so it stays inside the 66x66 of the 108x108 canvas
       that survives any launcher mask. Geometry and the exact transform are
       documented in drawable/ic_launcher_foreground.xml.
     - monochrome: the same mark as a single-colour silhouette for Material You
       themed icons (API 33+; ignored by the platform on older releases).

     Both layers are generated from brand/nexo-logo-inverso.svg by
     scripts/brand/Sync-AndroidBrandDrawables.ps1. Do not hand-edit. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
