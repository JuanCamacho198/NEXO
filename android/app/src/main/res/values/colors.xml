<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash background: the brand tile's base warm paper. The launcher icon
         plate is flat white (drawable/ic_launcher_background.xml), not this
         colour: the two surfaces meet at the splash handoff, and #FFFAF4 is
         warm enough to keep the splash from looking like a blank white screen. -->
    <color name="splash_background">#FFFAF4</color>

    <!-- Kept for the adaptive icon's background layer on any surface that still
         resolves a colour instead of the drawable. The drawn plate is white; see
         drawable/ic_launcher_background.xml. -->
    <color name="ic_launcher_background">#FFFFFFFF</color>
</resources>
