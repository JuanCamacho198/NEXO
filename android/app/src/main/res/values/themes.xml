<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Native splash screen (Android 12+ via core-splashscreen).
         Shows the NEXO mark instantly at launch, before Compose starts,
         then hands off to Theme.Nexo. -->
    <style name="Theme.Nexo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/nexo_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexo</item>
    </style>
</resources>
