                                      "content": "1. Definición de Columnas (360dp vs 412dp)",
                                      "lineHeight": 1.625,
                                      "textAlignVertical": "middle",
                                      "fontFamily": "Lato",
                                      "fontSize": 12,
                                      "fontWeight": "700"
                                    }
