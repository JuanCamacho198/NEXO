                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "LXy8v",
                                      "name": "Strong → Componente Compose:",
                                      "fill": "#cbd5e1ff",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Componente Compose: `ModalBottomSheet` de M3 con `rememberModalBottomSheetState(skipPartiallyExpanded =\nfalse)`.\n• Altura: Se abre inicialmente a ~65% de altura (permite ver portadas de fondo), expandible al 90% con scroll.\n• Drag handle: Píldora de 32dp x 4dp centrada en `#242A3A`.\n• Dismiss: Al deslizar hacia abajo, tap en el scrim oscuro, o presionar el botón `close` superior derecho.",
                                      "lineHeight": 1.625,
                                      "textAlignVertical": "middle",
                                      "fontFamily": "Lato",
                                      "fontSize": 12,
                                      "fontWeight": "700"
                                    }
                                  ]
                                }
