                                      "width": "fill_container",
                                      "content": "3. Portada Faltante con Identidad de Marca (Sin letra gigante al 30%)",
                                      "lineHeight": 1.625,
                                      "textAlignVertical": "middle",
                                      "fontFamily": "Lato",
