<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings owned by :feature:reader.

  `Owned here` keys are resolved only by reader sources (the reader state
  holders/managers), so they live here and nowhere else.

  `Duplicated from :app` keys are ALSO declared in app/src/main/res because
  non-reader code resolves them. Both modules carry identical text; that is the
  same precedent as `app_name` in :feature:settings and `app_name`/`nav_back`
  in :feature:auth.

  Everything else the reader renders (chrome labels, the settings sheet copy,
  the go-to-page strings) stays in :app, because the files that resolve those
  keys remain in :app (ReaderChrome, ReaderScreenOverlaysHost, the reader
  settings sections). This module takes no dependency on :app's R.
-->
<resources>
    <!-- Owned here: no reference outside :feature:reader. -->

    <string name="definition_no_service">Definitions need a connection.</string>
    <string name="highlights_snackbar_add_to_dictionary_failed">Couldn\'t add to dictionary</string>
    <string name="highlights_snackbar_added_to_dictionary">Added to dictionary</string>
    <string name="reader_pages_remaining">%1$s — %2$d pages left</string>
    <string name="reader_selection_no_text">No text selected</string>
    <string name="reader_snackbar_save_error">Couldn\'t save. Try again.</string>
    <string name="translation_no_result">No translation available for this text.</string>
    <string name="translation_offline">Translation needs a connection.</string>

    <!-- Duplicated from :app: non-reader code still resolves these. -->
    <string name="book_not_found">Book not found</string>
    <string name="dictionary_added">"%1$s" added to your dictionary.</string>
    <string name="dictionary_duplicate">"%1$s" is already in your dictionary.</string>
    <string name="error_unknown">Unexpected error. Please try again.</string>
    <string name="highlights_snackbar_copied">Copied to clipboard</string>
</resources>
