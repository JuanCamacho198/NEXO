---
export interface Props {
  icon: 'book' | 'library' | 'sparkles' | 'headphones' | 'globe' | 'archive';
  class?: string;
}

const { icon, class: className = 'h-5 w-5' } = Astro.props;

const paths: Record<Props['icon'], string> = {
  book: 'M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5V5.5Z M4 20.5A2.5 2.5 0 0 1 6.5 18H20',
  library: 'M4 4v16 M9 4v16 M13 5l4 1-4 14-4-1 4-14Z M17 4h3v16h-3',
  sparkles:
    'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3Z M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15Z',
  headphones:
    'M4 15v-2a8 8 0 0 1 16 0v2 M4 15h3v5H5a1 1 0 0 1-1-1v-4Z M20 15h-3v5h2a1 1 0 0 0 1-1v-4Z',
  globe:
    'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3 12h18 M12 3c3 3.5 3 14 0 18 M12 3c-3 3.5-3 14 0 18',
  archive: 'M3 5h18v4H3z M5 9v10h14V9 M10 13h4',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[icon]}></path>
</svg>
