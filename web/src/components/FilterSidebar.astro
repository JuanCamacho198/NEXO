---
import { t, type UiLocale } from '@/i18n';

export interface FacetOption {
  value: string;
  label: string;
  count: number;
}

export interface Props {
  locale: UiLocale;
  categories: FacetOption[];
  langs: FacetOption[];
  caps: FacetOption[];
  updated: FacetOption[];
}

const { locale, categories, langs, caps, updated } = Astro.props;

const groups = [
  { legend: t(locale, 'catalog.filter.categories'), facet: 'cat', opts: categories },
  { legend: t(locale, 'catalog.filter.languages'), facet: 'lang', opts: langs },
  { legend: t(locale, 'catalog.filter.caps'), facet: 'cap', opts: caps },
];

const visible = (opts: FacetOption[]) => opts.filter((o) => o.count > 0);
---

<div data-facet-panel class="flex flex-col gap-5">
  <div class="flex items-center justify-between">
    <p class="font-sans text-sm font-semibold uppercase tracking-wide text-text-muted">
      {t(locale, 'catalog.filter.title')}
    </p>
    <button
      type="button"
      data-facet-clear
      class="text-xs text-accent transition hover:brightness-110"
    >
      {t(locale, 'catalog.filter.clearAll')}
    </button>
  </div>
  {groups.map((g) => (
    <fieldset class="m-0 border-0 p-0">
      <legend class="p-0 font-sans text-xs font-semibold text-text-secondary">{g.legend}</legend>
      <div class="mt-2 flex flex-wrap gap-1.5">
        {visible(g.opts).map((o) => (
          <label class="facet-pill">
            <input type="checkbox" data-facet={g.facet} value={o.value} class="sr-only" />
            {o.label} ({o.count})
          </label>
        ))}
      </div>
    </fieldset>
  ))}
  <fieldset class="m-0 border-0 p-0">
    <legend class="p-0 font-sans text-xs font-semibold text-text-secondary">
      {t(locale, 'catalog.filter.updated')}
    </legend>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {visible(updated).map((o) => (
        <label class="facet-pill">
          <input type="radio" data-facet="upd" value={o.value} class="sr-only" />
          {o.label} ({o.count})
        </label>
      ))}
    </div>
  </fieldset>
</div>

<style>
  .facet-pill {
    border: 1px solid var(--color-border-subtle);
    border-radius: 9999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s,
      background 0.15s;
  }
  .facet-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .facet-pill:has(input:checked) {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .facet-pill:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
