---
import type { AddonAvailability, AddonLang } from '@/data/addons';
import { addonDetailHref, type AddonSeed } from '@/data/addons';
import { t, type UiLocale } from '@/i18n';
import AddonIcon from '@/components/AddonIcon.astro';

export interface Props {
  addon: AddonSeed;
  locale: UiLocale;
}

const { addon, locale } = Astro.props;

const langTag: Record<AddonLang, string> = {
  es: t(locale, 'catalog.tagEs'),
  en: t(locale, 'catalog.tagEn'),
  multi: t(locale, 'catalog.tagMulti'),
};

// The status pill is derived from the data model — never hardcoded. `builtin`
// really ships with the app, `community` is installable by URL, and `planned`
// has no working catalog yet.
const availabilityTag: Record<AddonAvailability, string> = {
  builtin: t(locale, 'catalog.tagIncluded'),
  community: t(locale, 'catalog.tagCommunity'),
  planned: t(locale, 'catalog.tagPlanned'),
};

const searchable = [addon.name, addon.author, addon.description[locale]].join(' ').toLowerCase();
---

<a
  href={addonDetailHref(locale, addon.id)}
  data-card
  data-name={addon.name.toLowerCase()}
  data-search={searchable}
  data-kind={addon.kind}
  data-langs={addon.languages.join(',')}
  data-resources={addon.resources.join(',')}
  data-cat={addon.category}
  data-updated={addon.updatedAt}
  class="group flex flex-col gap-3 rounded-xl border border-border-subtle bg-surface-1 p-5 transition hover:border-accent"
>
  <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-soft/15 text-accent">
    <AddonIcon icon={addon.icon} />
  </span>
  <span class="font-sans text-lg font-semibold text-text-primary group-hover:text-accent">
    {addon.name}
  </span>
  <span class="flex items-center gap-1.5 text-sm text-text-muted">
    <svg
      class="h-3.5 w-3.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"></path>
    </svg>
    {addon.author}
  </span>
  <span class="line-clamp-2 text-sm text-text-secondary">{addon.description[locale]}</span>
  <span class="mt-auto flex flex-wrap gap-1.5 pt-1">
    <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-medium text-accent">
      {availabilityTag[addon.availability]}
    </span>
    <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-text-secondary">
      {addon.languages.map((l) => langTag[l]).join(' · ')}
    </span>
    <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-text-secondary">
      {t(locale, `catalog.cat.${addon.category}`)}
    </span>
  </span>
</a>
