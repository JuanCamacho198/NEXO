---
import { getLocaleFromUrl, t, type UiLocale } from '@/i18n';
import type { UiKey } from '@/i18n/ui.en';

const locale: UiLocale = getLocaleFromUrl(Astro.url);
const pathname = Astro.url.pathname;

interface NavLink {
  href: string;
  key: UiKey;
}

const links: NavLink[] =
  locale === 'es'
    ? [
        { href: '/', key: 'nav.home' },
        { href: '/catalogo', key: 'nav.catalog' },
        { href: '/enviar', key: 'nav.submit' },
        { href: '/docs', key: 'nav.docs' },
      ]
    : [
        { href: '/en/', key: 'nav.home' },
        { href: '/en/catalog', key: 'nav.catalog' },
        { href: '/en/submit', key: 'nav.submit' },
        { href: '/en/docs', key: 'nav.docs' },
      ];

const brandHref = locale === 'es' ? '/' : '/en/';

function isActive(href: string): boolean {
  if (href === '/' || href === '/en/') {
    return pathname === '/' || pathname === '/en' || pathname === '/en/';
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}

const esToEn: Record<string, string> = {
  '/': '/en/',
  '/catalogo': '/en/catalog',
  '/enviar': '/en/submit',
  '/docs': '/en/docs',
};

function samePageHref(): string {
  if (locale === 'es') {
    if (esToEn[pathname] !== undefined) return esToEn[pathname];
    const detail = pathname.match(/^\/catalogo\/(.+)$/);
    if (detail) return `/en/catalog/${detail[1]}`;
    return '/en/';
  }
  if (pathname === '/en' || pathname === '/en/') return '/';
  const enDetail = pathname.match(/^\/en\/catalog\/(.+)$/);
  if (enDetail) return `/catalogo/${enDetail[1]}`;
  for (const [es, en] of Object.entries(esToEn)) {
    if (pathname === en) return es;
  }
  return '/';
}

const other = locale === 'es' ? 'en' : 'es';
const otherHref = samePageHref();
const menuOpenLabel = t(locale, 'nav.menuOpen');
const menuCloseLabel = t(locale, 'nav.menuClose');
---

<nav class="border-b border-border-subtle bg-surface-1" aria-label={t(locale, 'nav.aria')}>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href={brandHref} class="font-serif text-lg font-bold text-text-primary">
      Next<span class="text-accent">Page</span>
    </a>
    <div class="flex items-center gap-6">
      <button
        type="button"
        data-nav-toggle
        class="rounded-md border border-border-subtle p-2 text-text-secondary transition hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={menuOpenLabel}
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="5" x2="17" y2="5"></line>
          <line x1="3" y1="10" x2="17" y2="10"></line>
          <line x1="3" y1="15" x2="17" y2="15"></line>
        </svg>
      </button>
      <div class="hidden items-center gap-6 sm:flex">
        {links.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class={
                active
                  ? 'font-medium text-accent transition hover:text-accent'
                  : 'text-text-secondary transition hover:text-accent'
              }
            >
              {t(locale, link.key)}
            </a>
          );
        })}
      </div>
      <a
        href={otherHref}
        class="rounded-md border border-border-subtle px-2 py-1 text-sm text-text-muted transition hover:border-accent hover:text-accent"
        aria-label={t(locale, 'nav.langToggleAria')}
      >
        {other.toUpperCase()}
      </a>
    </div>
  </div>
  <div
    id="mobile-nav"
    data-nav-panel
    hidden
    class="border-b border-border-subtle bg-surface-1 sm:hidden"
  >
    <div class="flex flex-col gap-1 px-4 pb-3">
      {links.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? 'page' : undefined}
            class={
              active
                ? 'rounded-md px-2 py-2 font-medium text-accent transition hover:text-accent'
                : 'rounded-md px-2 py-2 text-text-secondary transition hover:text-accent'
            }
          >
            {t(locale, link.key)}
          </a>
        );
      })}
      <a
        href={otherHref}
        class="mt-1 rounded-md border border-border-subtle px-2 py-2 text-sm text-text-muted transition hover:border-accent hover:text-accent"
        aria-label={t(locale, 'nav.langToggleAria')}
      >
        {other.toUpperCase()}
      </a>
    </div>
  </div>
  <script define:vars={{ menuOpenLabel, menuCloseLabel }}>
    const nav = document.currentScript.closest('nav');
    const btn = nav.querySelector('[data-nav-toggle]');
    const panel = nav.querySelector('[data-nav-panel]');
    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? menuCloseLabel : menuOpenLabel);
      panel.hidden = !open;
    }
    btn.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (e) => {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  </script>
</nav>
