---
import { ADDONS } from '@/data/addons';
import type { AddonCategory } from '@/data/addons';
import { t, type UiLocale } from '@/i18n';
import AddonCard from '@/components/AddonCard.astro';
import FilterSidebar from '@/components/FilterSidebar.astro';

export interface Props {
  locale: UiLocale;
}

const { locale } = Astro.props;

const submitHref = locale === 'es' ? '/enviar' : '/en/submit';

// Two honest groups: addons that ship with NextPage (`builtin`) and addons
// installable by URL from the community. `planned` entries keep their detail
// pages and are listed later as an informational roadmap, but they must never
// inflate the facet or result counts.
const builtinAddons = ADDONS.filter((a) => a.availability === 'builtin');
const communityAddons = ADDONS.filter((a) => a.availability === 'community');
const catalogAddons = [...builtinAddons, ...communityAddons];
const plannedAddons = ADDONS.filter((a) => a.availability === 'planned');

const categories: AddonCategory[] = [
  'dominio-publico',
  'bibliotecas',
  'audiolibros',
  'wikis',
  'prensa',
  'independientes',
];

const facetCategories = categories.map((c) => ({
  value: c,
  label: t(locale, `catalog.cat.${c}`),
  count: catalogAddons.filter((a) => a.category === c).length,
}));

const facetLangs = [
  {
    value: 'es',
    label: t(locale, 'catalog.langEs'),
    count: catalogAddons.filter((a) => a.languages.includes('es') || a.languages.includes('multi'))
      .length,
  },
  {
    value: 'en',
    label: t(locale, 'catalog.langEn'),
    count: catalogAddons.filter((a) => a.languages.includes('en') || a.languages.includes('multi'))
      .length,
  },
  {
    value: 'multi',
    label: t(locale, 'catalog.langMulti'),
    count: catalogAddons.filter((a) => a.languages.includes('multi')).length,
  },
];

const facetCaps = [
  {
    value: 'search',
    label: t(locale, 'catalog.filter.capSearch'),
    count: catalogAddons.filter((a) => a.resources.includes('search')).length,
  },
  {
    value: 'book-details',
    label: t(locale, 'catalog.filter.capDetails'),
    count: catalogAddons.filter((a) => a.resources.includes('book-details')).length,
  },
];

const now = Date.now();
const DAY = 86400000;
const facetUpdated = [
  {
    value: '30',
    label: t(locale, 'catalog.filter.updated30'),
    count: catalogAddons.filter((a) => now - new Date(a.updatedAt).getTime() <= 30 * DAY).length,
  },
  {
    value: '90',
    label: t(locale, 'catalog.filter.updated90'),
    count: catalogAddons.filter((a) => now - new Date(a.updatedAt).getTime() <= 90 * DAY).length,
  },
];
---

<div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12" data-catalog-root>
  <header class="flex flex-col gap-2">
    <h1 class="font-serif text-4xl font-bold text-text-primary">{t(locale, 'catalog.title')}</h1>
    <p class="max-w-2xl text-text-secondary">{t(locale, 'catalog.subtitle')}</p>
  </header>

  <button
    type="button"
    data-drawer-trigger
    aria-expanded="false"
    aria-controls="filter-drawer"
    class="lg:hidden self-start rounded-lg border border-border-subtle px-4 py-2 text-sm text-text-secondary transition hover:border-accent hover:text-accent"
  >
    {t(locale, 'catalog.filter.openFilters')}
  </button>

  <div class="lg:flex lg:items-start lg:gap-8">
    <aside class="hidden w-64 shrink-0 lg:block lg:sticky lg:top-4">
      <div class="rounded-xl border border-border-subtle bg-surface-1 p-4">
        <FilterSidebar
          locale={locale}
          categories={facetCategories}
          langs={facetLangs}
          caps={facetCaps}
          updated={facetUpdated}
        />
      </div>
    </aside>

    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="relative flex-1">
          <span class="sr-only">{t(locale, 'catalog.searchAria')}</span>
          <svg
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
          </svg>
          <input
            data-search-input
            type="search"
            placeholder={t(locale, 'catalog.searchPlaceholder')}
            aria-label={t(locale, 'catalog.searchAria')}
            class="w-full rounded-lg border border-border-subtle bg-surface-1 py-2.5 pl-10 pr-12 text-sm text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none"
          />
          <kbd class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 rounded border border-border-subtle px-1.5 py-0.5 font-sans text-xs text-text-muted">
            /
          </kbd>
        </label>
        <label class="flex items-center gap-2 text-sm text-text-secondary">
          <span>{t(locale, 'catalog.sortLabel')}</span>
          <select
            data-sort-select
            class="rounded-lg border border-border-subtle bg-surface-1 px-3 py-2.5 text-sm text-text-primary focus:border-accent focus:outline-none"
          >
            <option value="relevance">{t(locale, 'catalog.sortRelevance')}</option>
            <option value="name">{t(locale, 'catalog.sortName')}</option>
            <option value="updated">{t(locale, 'catalog.sortUpdated')}</option>
          </select>
        </label>
      </div>

      <div class="mt-2 flex justify-end">
        <span data-count class="text-sm text-text-muted">
          {t(locale, 'catalog.count', { n: catalogAddons.length })}
        </span>
      </div>

      <div data-grid class="mt-4 flex flex-col gap-8">
        <section data-group="builtin" class="flex flex-col gap-3">
          <h2 class="font-sans text-lg font-semibold text-text-primary">
            {t(locale, 'catalog.groupBuiltin')}
          </h2>
          <div data-group-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {builtinAddons.map((addon) => (
              <AddonCard addon={addon} locale={locale} />
            ))}
          </div>
        </section>

        <section data-group="community" class="flex flex-col gap-3">
          <h2 class="font-sans text-lg font-semibold text-text-primary">
            {t(locale, 'catalog.groupCommunity')}
          </h2>
          {communityAddons.length > 0 ? (
            <div data-group-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {communityAddons.map((addon) => (
                <AddonCard addon={addon} locale={locale} />
              ))}
            </div>
          ) : (
            <div
              data-community-empty
              class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-subtle px-4 py-12 text-center"
            >
              <p class="font-sans text-lg font-semibold text-text-primary">
                {t(locale, 'catalog.communityEmptyTitle')}
              </p>
              <p class="max-w-md text-sm text-text-secondary">
                {t(locale, 'catalog.communityEmptySub')}
              </p>
              <a
                href={submitHref}
                class="mt-1 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition hover:brightness-110"
              >
                {t(locale, 'catalog.submitAddon')}
              </a>
            </div>
          )}
        </section>
      </div>

      <section
        data-roadmap
        class="mt-8 flex flex-col gap-3 rounded-xl border border-dashed border-border-subtle bg-surface-2/40 p-5"
      >
        <div class="flex items-center gap-2">
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-surface-2 text-text-muted"
            aria-hidden="true"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
          </span>
          <h2 class="font-sans text-lg font-semibold text-text-primary">
            {t(locale, 'catalog.roadmapTitle')}
          </h2>
        </div>
        <p class="max-w-2xl text-sm text-text-secondary">{t(locale, 'catalog.roadmapSub')}</p>
        <div class="grid grid-cols-1 gap-4 opacity-80 sm:grid-cols-2 lg:grid-cols-4">
          {plannedAddons.map((addon) => (
            <AddonCard addon={addon} locale={locale} />
          ))}
        </div>
      </section>
    </div>
  </div>

  <div
    id="filter-drawer"
    hidden
    class="fixed inset-0 z-50 lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label={t(locale, 'catalog.filter.title')}
  >
    <div data-drawer-backdrop class="absolute inset-0 bg-black/40"></div>
    <div class="absolute inset-x-0 bottom-0 max-h-[80vh] overflow-y-auto rounded-t-2xl border border-border-subtle bg-surface-1 p-4">
      <div class="mb-2 flex items-center justify-between">
        <p class="font-sans text-sm font-semibold text-text-primary">
          {t(locale, 'catalog.filter.title')}
        </p>
        <button
          type="button"
          data-drawer-close
          aria-label={t(locale, 'catalog.filter.closeFilters')}
          class="rounded-lg border border-border-subtle px-3 py-1.5 text-sm text-text-secondary transition hover:border-accent hover:text-accent"
        >
          ×
        </button>
      </div>
      <FilterSidebar
        locale={locale}
        categories={facetCategories}
        langs={facetLangs}
        caps={facetCaps}
        updated={facetUpdated}
      />
    </div>
  </div>

  <div
    data-empty
    hidden
    class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-border-subtle px-4 py-16 text-center"
  >
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-surface-2 text-text-muted">
      <svg
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.5-3.5"></path>
      </svg>
    </span>
    <p class="font-sans text-lg font-semibold text-text-primary">
      {t(locale, 'catalog.emptyTitle')}
    </p>
    <p class="text-sm text-text-secondary">{t(locale, 'catalog.emptySub')}</p>
    <div class="flex gap-2 pt-1">
      <button
        data-clear
        class="rounded-lg border border-border-subtle px-4 py-2 text-sm text-text-secondary transition hover:border-accent hover:text-accent"
      >
        {t(locale, 'catalog.clearFilters')}
      </button>
      <a
        href={submitHref}
        class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition hover:brightness-110"
      >
        {t(locale, 'catalog.submitAddon')}
      </a>
    </div>
  </div>
</div>

<script
  define:vars={{
    countTemplate: t(locale, 'catalog.count'),
    countOne: t(locale, 'catalog.countOne'),
  }}
>
  const root = document.querySelector('[data-catalog-root]');
  const search = root.querySelector('[data-search-input]');
  const sort = root.querySelector('[data-sort-select]');
  const grid = root.querySelector('[data-grid]');
  const empty = root.querySelector('[data-empty]');
  const countEl = root.querySelector('[data-count]');
  const cards = [...grid.querySelectorAll('[data-card]')];
  const groupGrids = [...grid.querySelectorAll('[data-group-grid]')];
  const trigger = root.querySelector('[data-drawer-trigger]');
  const drawer = root.querySelector('#filter-drawer');
  const closeBtn = root.querySelector('[data-drawer-close]');
  const backdrop = root.querySelector('[data-drawer-backdrop]');

  function allInputs(facet) {
    return [...root.querySelectorAll(`input[data-facet="${facet}"]`)];
  }
  function selSet(facet) {
    return new Set(
      allInputs(facet)
        .filter((i) => i.checked)
        .map((i) => i.value),
    );
  }
  function matchLangAny(cardLangs, sel) {
    if (sel.size === 0) return true;
    const langs = cardLangs.split(',');
    for (const f of sel) {
      if (f === 'multi' ? langs.includes('multi') : langs.includes(f) || langs.includes('multi'))
        return true;
    }
    return false;
  }
  function daysSince(card) {
    return Math.max(0, (Date.now() - new Date(card.dataset.updated).getTime()) / 86400000);
  }
  function readState() {
    const updInput = root.querySelector('input[data-facet="upd"]:checked');
    return {
      q: search.value.trim().toLowerCase(),
      cats: selSet('cat'),
      langs: selSet('lang'),
      caps: selSet('cap'),
      upd: updInput ? updInput.value : 'all',
      sort: sort.value,
    };
  }

  function apply() {
    const state = readState();
    const visible = [];
    for (const c of cards) {
      const resources = (c.dataset.resources || '').split(',');
      const capsOk = state.caps.size === 0 || [...state.caps].every((r) => resources.includes(r));
      const ok =
        (!state.q || c.dataset.search.includes(state.q)) &&
        (state.cats.size === 0 || state.cats.has(c.dataset.cat)) &&
        matchLangAny(c.dataset.langs, state.langs) &&
        capsOk &&
        (state.upd === 'all' || daysSince(c) <= Number(state.upd));
      c.style.display = ok ? '' : 'none';
      if (ok) visible.push(c);
    }
    // Sort inside each group so the builtin/community sections stay intact.
    for (const g of groupGrids) {
      const groupVisible = visible.filter((c) => g.contains(c));
      groupVisible.sort((a, b) => {
        if (state.sort === 'name') return a.dataset.name.localeCompare(b.dataset.name);
        if (state.sort === 'updated') return b.dataset.updated.localeCompare(a.dataset.updated);
        return 0;
      });
      for (const c of groupVisible) g.appendChild(c);
    }
    empty.hidden = visible.length > 0;
    countEl.textContent =
      visible.length === 1 ? countOne : countTemplate.replace('{{n}}', String(visible.length));

    const params = new URLSearchParams();
    if (state.q) params.set('q', state.q);
    if (state.cats.size) params.set('cat', [...state.cats].join(','));
    if (state.langs.size) params.set('lang', [...state.langs].join(','));
    if (state.caps.size) params.set('cap', [...state.caps].join(','));
    if (state.upd !== 'all') params.set('upd', state.upd);
    if (state.sort !== 'relevance') params.set('sort', state.sort);
    const qs = params.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
  }

  function syncTwins(input) {
    allInputs(input.dataset.facet).forEach((i) => {
      if (i.value === input.value && i.type === input.type) i.checked = input.checked;
    });
  }

  root.addEventListener('change', (e) => {
    const input = e.target.closest('input[data-facet]');
    if (!input) return;
    if (input.dataset.facet === 'upd' && input.checked) {
      allInputs('upd').forEach((i) => {
        if (i.value !== input.value) i.checked = false;
      });
    }
    syncTwins(input);
    apply();
  });

  search.addEventListener('input', () => {
    apply();
  });
  sort.addEventListener('change', () => {
    apply();
  });

  function clearAll() {
    search.value = '';
    sort.value = 'relevance';
    root.querySelectorAll('input[data-facet]').forEach((i) => {
      i.checked = i.dataset.facet === 'upd' && i.value === 'all';
    });
    apply();
  }
  root.querySelector('[data-clear]').addEventListener('click', clearAll);
  root.querySelectorAll('[data-facet-clear]').forEach((b) => b.addEventListener('click', clearAll));

  function openDrawer(open) {
    drawer.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
    if (open) {
      const first = drawer.querySelector('input, button');
      if (first) first.focus();
    } else {
      trigger.focus();
    }
  }
  trigger.addEventListener('click', () => openDrawer(drawer.hidden));
  closeBtn.addEventListener('click', () => openDrawer(false));
  backdrop.addEventListener('click', () => openDrawer(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer.hidden) {
      openDrawer(false);
      return;
    }
    if (e.key === '/' && document.activeElement !== search && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      search.focus();
    }
  });

  // Load-time URL parse (?kind= is parsed and ignored for back-compat)
  const params = new URLSearchParams(location.search);
  for (const facet of ['cat', 'lang', 'cap']) {
    const tokens = (params.get(facet) || '').split(',').filter(Boolean);
    for (const tk of tokens) {
      allInputs(facet).forEach((i) => {
        if (i.value === tk) i.checked = true;
      });
    }
  }
  const updParam = params.get('upd');
  if (updParam === '30' || updParam === '90') {
    allInputs('upd').forEach((i) => {
      i.checked = i.value === updParam;
    });
  }
  const qParam = params.get('q');
  if (qParam) search.value = qParam;
  const sortParam = params.get('sort');
  if (sortParam === 'name' || sortParam === 'updated' || sortParam === 'relevance')
    sort.value = sortParam;
  apply();
</script>
