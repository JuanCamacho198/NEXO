---
import { t, type UiLocale } from '@/i18n';

export interface Props {
  locale: UiLocale;
}

const { locale } = Astro.props;

const docsHref = locale === 'es' ? '/docs' : '/en/docs';
const contribHref = 'https://github.com/JuanCamacho198/NEXTPAGE/blob/main/CONTRIBUTING.md';
const issueHref =
  'https://github.com/JuanCamacho198/NEXTPAGE/issues/new?template=addon-submission.yml';

const steps = [
  { title: t(locale, 'submit.step1Title'), sub: t(locale, 'submit.step1Sub') },
  { title: t(locale, 'submit.step2Title'), sub: t(locale, 'submit.step2Sub') },
  { title: t(locale, 'submit.step3Title'), sub: t(locale, 'submit.step3Sub') },
  { title: t(locale, 'submit.step4Title'), sub: t(locale, 'submit.step4Sub') },
];

const templateJson = JSON.stringify(
  {
    id: 'mi-addon',
    name: 'Mi Addon',
    version: '1.0.0',
    catalogs: [{ type: 'book-catalog', id: 'mi-addon', name: 'Mi Addon' }],
    resources: ['search'],
  },
  null,
  2,
);
---

<div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-12" data-submit-root>
  <section class="flex flex-col items-center gap-6 py-8 text-center">
    <span class="inline-flex items-center rounded-full border border-border-subtle bg-surface-1 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-widest text-text-secondary">
      {t(locale, 'submit.badge')}
    </span>
    <h1 class="max-w-3xl font-serif text-5xl font-bold text-text-primary">
      {t(locale, 'submit.title')}
    </h1>
    <p class="max-w-2xl text-lg text-text-secondary">{t(locale, 'submit.subtitle')}</p>
  </section>

  <section class="flex flex-col gap-6">
    <ol class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {steps.map((s, i) => (
        <li class="rounded-xl border border-border-subtle bg-surface-1 p-5">
          <p class="font-mono text-sm text-accent">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="mt-2 font-sans text-base font-semibold text-text-primary">{s.title}</h2>
          <p class="mt-1 text-sm text-text-secondary">{s.sub}</p>
        </li>
      ))}
    </ol>
    <div class="flex flex-col items-start gap-3">
      <a
        href={issueHref}
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-2.5 font-sans text-sm font-semibold text-accent-ink transition hover:brightness-110"
      >
        {t(locale, 'submit.issueCta')}
      </a>
    </div>
  </section>

  <section class="rounded-xl border border-border-subtle bg-surface-1 p-5">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="font-sans text-base font-semibold text-text-primary">
          {t(locale, 'submit.templateTitle')}
        </h2>
        <p class="mt-1 text-sm text-text-secondary">{t(locale, 'submit.templateDesc')}</p>
      </div>
      <button
        data-copy={templateJson}
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-ink transition hover:brightness-110"
      >
        {t(locale, 'submit.copyButton')}
      </button>
    </div>
    <p class="mb-2 font-mono text-xs text-text-muted">{t(locale, 'submit.templateFile')}</p>
    <pre class="overflow-x-auto rounded-lg bg-surface-0 p-4 font-mono text-xs leading-relaxed text-text-secondary">{templateJson}</pre>
    <p data-copied hidden class="mt-2 text-xs text-emerald-400">
      {t(locale, 'submit.copied')}
    </p>
  </section>

  <section class="flex flex-col items-center gap-3 text-center">
    <p class="max-w-2xl text-sm text-text-secondary">{t(locale, 'submit.installNote')}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={docsHref}
        class="rounded-lg bg-accent px-6 py-2.5 font-sans text-sm font-semibold text-accent-ink transition hover:brightness-110"
      >
        {t(locale, 'submit.docsCta')}
      </a>
      <a
        href={contribHref}
        class="rounded-lg border border-border-subtle px-6 py-2.5 font-sans text-sm font-semibold text-text-primary transition hover:border-accent hover:text-accent"
      >
        {t(locale, 'submit.contribGuideCta')}
      </a>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector('[data-submit-root]');
  if (root) {
    const done = root.querySelector('[data-copied]') as HTMLElement | null;
    root.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        if (done) {
          done.hidden = false;
          setTimeout(() => (done.hidden = true), 2000);
        }
      });
    });
  }
</script>
