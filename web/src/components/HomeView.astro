---
import {
  ADDONS,
  addonDetailHref,
  catalogHref,
  type AddonAvailability,
  type AddonCategory,
} from '@/data/addons';
import { t, type UiLocale } from '@/i18n';

export interface Props {
  locale: UiLocale;
}

const { locale } = Astro.props;

const catalogUrl = catalogHref(locale);
const submitHref = locale === 'es' ? '/enviar' : '/en/submit';

// The home advertises what actually works: `planned` entries are registered but
// have no working catalog, so they never inflate the counts. They are still
// listed below, each carrying its real status.
const workingAddons = ADDONS.filter((a) => a.availability !== 'planned');
const addonCount = workingAddons.length;
const sourceCount = workingAddons.reduce((n, a) => n + a.catalogs.length, 0);
const plannedCount = ADDONS.length - addonCount;

const availabilityTag: Record<AddonAvailability, string> = {
  builtin: t(locale, 'catalog.tagIncluded'),
  community: t(locale, 'catalog.tagCommunity'),
  planned: t(locale, 'catalog.tagPlanned'),
};

const categories: AddonCategory[] = [
  'dominio-publico',
  'bibliotecas',
  'audiolibros',
  'wikis',
  'prensa',
  'independientes',
];

// Match the catalog facets: `planned` entries never inflate a category count.
const countFor = (c: AddonCategory) => workingAddons.filter((a) => a.category === c).length;

const latest = [...ADDONS].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));

const rtf = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' });
const agoFor = (iso: string) => {
  const days = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
  return rtf.format(-days, 'day');
};

const steps = [
  { title: t(locale, 'home.step1Title'), sub: t(locale, 'home.step1Sub') },
  { title: t(locale, 'home.step2Title'), sub: t(locale, 'home.step2Sub') },
  { title: t(locale, 'home.step3Title'), sub: t(locale, 'home.step3Sub') },
];
---

<div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-12">
  <section class="flex flex-col items-center gap-6 py-8 text-center">
    <span class="inline-flex items-center rounded-full border border-border-subtle bg-surface-1 px-4 py-1.5 text-sm text-text-secondary">
      {t(locale, 'home.badge')}
    </span>
    <h1 class="max-w-3xl font-serif text-5xl font-bold text-text-primary">
      {t(locale, 'home.title')}
    </h1>
    <p class="max-w-2xl text-lg text-text-secondary">{t(locale, 'home.subtitle')}</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={catalogUrl}
        class="rounded-lg bg-accent px-6 py-2.5 font-sans text-sm font-semibold text-accent-ink transition hover:brightness-110"
      >
        {t(locale, 'home.catalogCta')}
      </a>
      <a
        href={submitHref}
        class="rounded-lg border border-border-subtle px-6 py-2.5 font-sans text-sm font-semibold text-text-primary transition hover:border-accent hover:text-accent"
      >
        {t(locale, 'home.submitCta')}
      </a>
    </div>
  </section>

  <section aria-label={t(locale, 'home.statsAria')} class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-xl border border-border-subtle bg-surface-1 p-6 text-center">
      <p class="font-serif text-4xl font-bold text-text-primary">{addonCount}</p>
      <p class="mt-1 text-sm text-text-secondary">{t(locale, 'home.statsAddons')}</p>
    </div>
    <div class="rounded-xl border border-border-subtle bg-surface-1 p-6 text-center">
      <p class="font-serif text-4xl font-bold text-text-primary">{sourceCount}</p>
      <p class="mt-1 text-sm text-text-secondary">{t(locale, 'home.statsSources')}</p>
    </div>
    <div class="rounded-xl border border-border-subtle bg-surface-1 p-6 text-center">
      <p class="font-serif text-4xl font-bold text-text-primary">{plannedCount}</p>
      <p class="mt-1 text-sm text-text-secondary">{t(locale, 'home.statsPlanned')}</p>
    </div>
  </section>

  <section class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <p class="font-sans text-xs font-semibold uppercase tracking-widest text-text-muted">
        {t(locale, 'home.stepsEyebrow')}
      </p>
      <h2 class="font-serif text-3xl font-bold text-text-primary">
        {t(locale, 'home.stepsTitle')}
      </h2>
    </div>
    <ol class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-xl border border-border-subtle bg-surface-1 p-5">
          <p class="font-mono text-sm text-accent">{i + 1}</p>
          <h3 class="mt-2 font-sans text-base font-semibold text-text-primary">{s.title}</h3>
          <p class="mt-1 text-sm text-text-secondary">{s.sub}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <p class="font-sans text-xs font-semibold uppercase tracking-widest text-text-muted">
        {t(locale, 'home.categoriesEyebrow')}
      </p>
      <h2 class="font-serif text-3xl font-bold text-text-primary">
        {t(locale, 'home.categoriesTitle')}
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <a
          href={catalogUrl}
          class="rounded-xl border border-border-subtle bg-surface-1 p-5 transition hover:border-accent"
        >
          <h3 class="font-sans text-base font-semibold text-text-primary">
            {t(locale, `catalog.cat.${c}`)}
          </h3>
          <p class="mt-1 text-sm text-text-secondary">{t(locale, `home.catDesc.${c}`)}</p>
          <p class="mt-3 text-sm text-text-muted">
            {countFor(c) === 1
              ? t(locale, 'catalog.countOne')
              : t(locale, 'catalog.count', { n: countFor(c) })}
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <p class="font-sans text-xs font-semibold uppercase tracking-widest text-text-muted">
        {t(locale, 'home.latestEyebrow')}
      </p>
      <h2 class="font-serif text-3xl font-bold text-text-primary">
        {t(locale, 'home.updatesTitle')}
      </h2>
    </div>
    <ul class="flex flex-col gap-3">
      {latest.map((addon) => (
        <li class="rounded-xl border border-border-subtle bg-surface-1">
          <a href={addonDetailHref(locale, addon.id)} class="flex items-center gap-4 px-4 py-3">
            <span class="min-w-0 flex-1">
              <span class="block truncate font-sans text-sm font-semibold text-text-primary">
                {addon.name}
              </span>
              <span class="block truncate text-sm text-text-secondary">
                {addon.description[locale]}
              </span>
            </span>
            <span class="flex shrink-0 flex-col items-end gap-1">
              <span
                class={`rounded-full px-2.5 py-0.5 text-xs ${
                  addon.availability === 'planned'
                    ? 'bg-surface-2 text-text-muted'
                    : 'bg-accent/15 text-accent'
                }`}
              >
                {availabilityTag[addon.availability]}
              </span>
              <span class="text-xs text-text-muted">
                {t(locale, 'detail.updatedAgo', { x: agoFor(addon.updatedAt) })}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p>
      <a
        href={catalogUrl}
        class="text-sm font-semibold text-accent transition hover:brightness-110"
      >
        {t(locale, 'home.seeAll')} →
      </a>
    </p>
  </section>
</div>
