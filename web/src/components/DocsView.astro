---
import { t, type UiLocale } from '@/i18n';

export interface Props {
  locale: UiLocale;
}

const { locale } = Astro.props;

const submitHref = locale === 'es' ? '/enviar' : '/en/submit';

const gates = [
  t(locale, 'docs.approvalGateHttps'),
  t(locale, 'docs.approvalGateSize'),
  t(locale, 'docs.approvalGateType'),
  t(locale, 'docs.approvalGateShape'),
  t(locale, 'docs.approvalGateUnsupportedType'),
];

const protocolDocHref = 'https://github.com/JuanCamacho198/NEXO/blob/main/docs/addon-protocol.md';

// Summary only: the full protocol lives in docs/addon-protocol.md, so this page
// states the shape and links out instead of restating a contract it would drift from.
const summary = [
  t(locale, 'docs.v3Summary1'),
  t(locale, 'docs.v3Summary2'),
  t(locale, 'docs.v3Summary3'),
  t(locale, 'docs.v3Summary4'),
];

const rules = [
  { title: t(locale, 'docs.ruleSizeTitle'), sub: t(locale, 'docs.ruleSizeSub') },
  { title: t(locale, 'docs.ruleContentTypeTitle'), sub: t(locale, 'docs.ruleContentTypeSub') },
  { title: t(locale, 'docs.ruleParseTitle'), sub: t(locale, 'docs.ruleParseSub') },
  { title: t(locale, 'docs.ruleShapeTitle'), sub: t(locale, 'docs.ruleShapeSub') },
  { title: t(locale, 'docs.ruleOrderTitle'), sub: t(locale, 'docs.ruleOrderSub') },
  { title: t(locale, 'docs.ruleUnknownTitle'), sub: t(locale, 'docs.ruleUnknownSub') },
  { title: t(locale, 'docs.ruleCodesTitle'), sub: t(locale, 'docs.ruleCodesSub') },
];

const checklist = [
  t(locale, 'docs.check1'),
  t(locale, 'docs.check2'),
  t(locale, 'docs.check3'),
  t(locale, 'docs.check4'),
  t(locale, 'docs.check5'),
  t(locale, 'docs.check6'),
];
---

<div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-12">
  <section class="flex flex-col items-center gap-6 py-8 text-center">
    <span class="inline-flex items-center rounded-full border border-border-subtle bg-surface-1 px-4 py-1.5 font-sans text-xs font-semibold uppercase tracking-widest text-text-secondary">
      {t(locale, 'docs.badge')}
    </span>
    <h1 class="max-w-3xl font-serif text-5xl font-bold text-text-primary">
      {t(locale, 'docs.title')}
    </h1>
    <p class="max-w-2xl text-lg text-text-secondary">{t(locale, 'docs.subtitle')}</p>
  </section>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="flex flex-col gap-12 lg:col-span-2">
      <section class="flex flex-col gap-4">
        <h2 class="font-serif text-3xl font-bold text-text-primary">{t(locale, 'docs.v3Title')}</h2>
        <ul class="flex flex-col gap-3">
          {summary.map((item) => (
            <li class="rounded-xl border border-border-subtle bg-surface-1 px-4 py-3">
              <p class="font-mono text-xs leading-relaxed text-text-secondary">{item}</p>
            </li>
          ))}
        </ul>
        <div>
          <a
            href={protocolDocHref}
            class="inline-flex items-center gap-2 rounded-lg border border-border-subtle px-6 py-2.5 font-sans text-sm font-semibold text-text-primary transition hover:border-accent hover:text-accent"
          >
            {t(locale, 'docs.v3DocCta')}
          </a>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-serif text-3xl font-bold text-text-primary">
          {t(locale, 'docs.checklistTitle')}
        </h2>
        <ul class="flex flex-col gap-3">
          {checklist.map((item) => (
            <li class="flex items-start gap-3 rounded-xl border border-border-subtle bg-surface-1 px-4 py-3">
              <svg
                class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M4 12.5l5 5L20 6.5" />
              </svg>
              <span class="text-sm text-text-secondary">{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <aside
      aria-label={t(locale, 'docs.rulesTitle')}
      class="h-fit rounded-xl border border-border-subtle bg-surface-1 p-5 lg:sticky lg:top-4"
    >
      <h2 class="mb-4 font-sans text-sm font-semibold uppercase tracking-wide text-text-muted">
        {t(locale, 'docs.rulesTitle')}
      </h2>
      <ul class="flex flex-col gap-4">
        {rules.map((r) => (
          <li class="flex flex-col gap-1">
            <p class="font-sans text-sm font-semibold text-text-primary">{r.title}</p>
            <p class="text-sm text-text-secondary">{r.sub}</p>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  <section class="flex flex-col gap-4">
    <h2 class="font-serif text-3xl font-bold text-text-primary">
      {t(locale, 'docs.approvalTitle')}
    </h2>
    <p class="max-w-3xl text-base text-text-secondary">{t(locale, 'docs.approvalIntro')}</p>
    <ul class="flex flex-col gap-3">
      {gates.map((gate) => (
        <li class="rounded-xl border border-border-subtle bg-surface-1 px-4 py-3">
          <p class="font-mono text-xs leading-relaxed text-text-secondary">{gate}</p>
        </li>
      ))}
    </ul>
    <p class="max-w-3xl text-sm text-text-secondary">{t(locale, 'docs.approvalNetwork')}</p>
    <p class="max-w-3xl text-sm text-text-secondary">{t(locale, 'docs.approvalLanding')}</p>
    <p class="max-w-3xl text-sm text-text-secondary">{t(locale, 'docs.approvalLicense')}</p>
    <div>
      <a
        href={submitHref}
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-2.5 font-sans text-sm font-semibold text-accent-ink transition hover:brightness-110"
      >
        {t(locale, 'docs.approvalSubmitCta')}
      </a>
    </div>
  </section>
</div>
