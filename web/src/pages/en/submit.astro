---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubmitView from '@/components/SubmitView.astro';
import { t } from '@/i18n';

const locale = 'en' as const;
---

<BaseLayout
  title={`${t(locale, 'submit.title')} — NextPage`}
  description={t(locale, 'submit.subtitle')}
  canonicalPath="/en/submit"
  alternateEs="/enviar"
  alternateEn="/en/submit"
>
  <SubmitView locale={locale} />
</BaseLayout>
