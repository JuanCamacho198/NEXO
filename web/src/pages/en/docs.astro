---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocsView from '@/components/DocsView.astro';
import { t } from '@/i18n';

const locale = 'en' as const;
---

<BaseLayout
  title={`${t(locale, 'docs.title')} — NextPage`}
  description={t(locale, 'docs.subtitle')}
  canonicalPath="/en/docs"
  alternateEs="/docs"
  alternateEn="/en/docs"
>
  <DocsView locale={locale} />
</BaseLayout>
