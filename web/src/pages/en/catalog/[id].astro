---
import { ADDONS, addonDetailHref, getAddon } from '@/data/addons';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DetailView from '@/components/DetailView.astro';

export function getStaticPaths() {
  return ADDONS.map((a) => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const addon = getAddon(id ?? '');
if (!addon) return new Response('Not found', { status: 404 });
const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const abs = (p: string): string => (site ? `${site}${p}` : p);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: addon.name,
  applicationCategory: 'Utilities',
  operatingSystem: 'Any',
  softwareVersion: addon.version,
  author: { '@type': 'Organization', name: addon.author },
  license: addon.license,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  url: abs(addonDetailHref('en', addon.id)),
  description: addon.description.en,
};
---

<BaseLayout
  title={`${addon.name} — NextPage`}
  description={addon.description.en}
  canonicalPath={addonDetailHref('en', addon.id)}
  alternateEs={addonDetailHref('es', addon.id)}
  alternateEn={addonDetailHref('en', addon.id)}
  ogType="article"
  jsonLd={jsonLd}
>
  <DetailView addon={addon} locale="en" />
</BaseLayout>
