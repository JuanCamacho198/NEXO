---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeView from '@/components/HomeView.astro';
import { t } from '@/i18n';

const locale = 'es' as const;
const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NEXO Addons',
  url: site ? `${site}/` : '/',
  inLanguage: 'es',
};
---

<BaseLayout
  title={`${t(locale, 'home.title')} — NEXO`}
  description={t(locale, 'home.subtitle')}
  canonicalPath="/"
  alternateEs="/"
  alternateEn="/en/"
  jsonLd={jsonLd}
>
  <HomeView locale={locale} />
</BaseLayout>
