---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CatalogView from '@/components/CatalogView.astro';
import { ADDONS, addonDetailHref } from '@/data/addons';
import { t } from '@/i18n';

const locale = 'es' as const;
const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const abs = (p: string): string => (site ? `${site}${p}` : p);
// Machine-readable surfaces must not advertise addons that do not work yet:
// only `builtin` / `community` entries are listed in the ItemList.
const machineAddons = ADDONS.filter(
  (addon) => addon.availability === 'builtin' || addon.availability === 'community',
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t(locale, 'catalog.title'),
  itemListElement: machineAddons.map((addon, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: addon.name,
    url: abs(addonDetailHref(locale, addon.id)),
  })),
};
---

<BaseLayout
  title={t(locale, 'catalog.pageTitle')}
  description={t(locale, 'catalog.subtitle')}
  canonicalPath="/catalogo"
  alternateEs="/catalogo"
  alternateEn="/en/catalog"
  jsonLd={jsonLd}
>
  <CatalogView locale="es" />
</BaseLayout>
