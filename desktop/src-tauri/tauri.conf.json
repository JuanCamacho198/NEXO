{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo Desktop",
  "version": "0.3.2",
  "identifier": "com.nexo.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexo Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: https://covers.openlibrary.org https://www.gutenberg.org https://books.google.com; style-src 'self' 'unsafe-inline' asset: http://asset.localhost https://asset.localhost; font-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' asset: http://asset.localhost https://asset.localhost https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://*.supabase.co https://gutendex.com https://openlibrary.org https://covers.openlibrary.org https://*.archive.org https://github.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "nexo",
          "nextpage-desktop",
          "nextpage"
        ]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OUREODBFNDZFMkNDQTIKUldTaXpPSkdEdGlkcUhCNlpscmZuZHZtYVhoY2JOOUUzMmxpY2lyT095M0FTMGpvZEt4bHVneloK",
      "endpoints": [
        "https://github.com/JuanCamacho198/NEXTPAGE/releases/download/desktop-v0.3.2/latest.json"
      ]
    },
    "fs": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": []
  }
}
