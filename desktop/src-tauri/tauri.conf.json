{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexo Desktop",
  "version": "0.7.0",
  "identifier": "com.nexo.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexo Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https://covers.openlibrary.org https://www.gutenberg.org https://books.google.com https://standardebooks.org; style-src 'self' 'unsafe-inline' asset: http://asset.localhost https://asset.localhost; font-src 'self' asset: http://asset.localhost https://asset.localhost; connect-src 'self' asset: http://asset.localhost https://asset.localhost https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://*.supabase.co https://gutendex.com https://openlibrary.org https://covers.openlibrary.org http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "nexo",
          "nextpage-desktop",
          "nextpage"
        ]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OUREODBFNDZFMkNDQTIKUldTaXpPSkdEdGlkcUhCNlpscmZuZHZtYVhoY2JOOUUzMmxpY2lyT095M0FTMGpvZEt4bHVneloK",
      "endpoints": [
        "https://github.com/JuanCamacho198/NEXO/releases/download/desktop-latest/latest.json"
      ]
    },
    "fs": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "shortDescription": "EPUB reader with local-first storage and sync",
    "longDescription": "NEXO Desktop is a local-first EPUB reader: books, highlights, dictionary and reading progress live in a local SQLite database and sync to Supabase only when you sign in.",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB document",
        "description": "EPUB document",
        "mimeType": "application/epub+zip",
        "role": "Viewer",
        "rank": "Owner"
      }
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "librsvg2"
        ]
      }
    }
  }
}
