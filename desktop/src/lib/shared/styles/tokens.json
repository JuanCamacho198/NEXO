{
  "$schema": "./tokens.schema.json",
  "theme": {
    "dark": {
      "color": {
        "background": "#08111f",
        "surface": "rgba(16, 28, 44, 0.84)",
        "panelAccent": "rgba(73, 212, 255, 0.08)",
        "primary": "#f8fbff",
        "secondary": "#dbe7f6",
        "tertiary": "#8fa3bf",
        "text": "#f8fbff",
        "textMuted": "#8fa3bf"
      },
      "semantic": {
        "error": "#ff7b83",
        "accentBlue": "#49d4ff",
        "accentSoft": "rgba(73, 212, 255, 0.1)"
      },
      "border": {
        "default": "rgba(148, 173, 206, 0.18)",
        "strong": "rgba(148, 173, 206, 0.3)"
      },
      "shadow": {
        "soft": "0 4px 20px rgba(0, 0, 0, 0.2)",
        "glow": "0 0 15px rgba(73, 212, 255, 0.15)",
        "glowHover": "0 0 20px rgba(73, 212, 255, 0.3)"
      },
      "gradient": {
        "surface": [
          "radial-gradient(circle at top left, rgba(73, 212, 255, 0.12), transparent 26%)",
          "radial-gradient(circle at top right, rgba(245, 207, 122, 0.1), transparent 24%)",
          "linear-gradient(180deg, #07111d 0%, #09111d 45%, #08101a 100%)"
        ]
      }
    },
    "light": {
      "color": {
        "background": "#eef2f7",
        "surface": "rgba(255, 255, 255, 0.9)",
        "panelAccent": "rgba(0, 110, 200, 0.06)",
        "primary": "#111827",
        "secondary": "#1e3a5f",
        "tertiary": "#4a6888",
        "text": "#111827",
        "textMuted": "#4a6888"
      },
      "semantic": {
        "error": "#c0392b",
        "accentBlue": "#006ec8",
        "accentSoft": "rgba(0, 110, 200, 0.12)"
      },
      "border": {
        "default": "rgba(30, 58, 95, 0.15)",
        "strong": "rgba(30, 58, 95, 0.28)"
      },
      "shadow": {
        "soft": "0 4px 20px rgba(0, 0, 0, 0.08)",
        "glow": "0 0 15px rgba(0, 110, 200, 0.14)",
        "glowHover": "0 0 20px rgba(0, 110, 200, 0.26)"
      },
      "gradient": {
        "surface": [
          "radial-gradient(circle at top left, rgba(0, 110, 200, 0.07), transparent 28%)",
          "radial-gradient(circle at top right, rgba(255, 190, 80, 0.08), transparent 26%)",
          "linear-gradient(180deg, #e8eef6 0%, #eef2f8 50%, #f0f4fa 100%)"
        ]
      }
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "duration": {
    "fast": "150ms",
    "normal": "250ms",
    "slow": "350ms"
  },
  "font": {
    "sans": "\"Manrope\", \"Segoe UI\", Arial, sans-serif",
    "serif": "\"Newsreader Variable\", \"Newsreader\", \"Times New Roman\", serif"
  }
}
