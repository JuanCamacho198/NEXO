# Sentry — leave empty in CI; populate locally only. NEVER commit real values.
# Source: `sdd/sentry-cross-platform/spec` — error-reporting-cross-platform.
#
# `SENTRY_AUTH_TOKEN` MUST stay out of source control. The build plugin reads
# `SENTRY_AUTH_TOKEN` / `SENTRY_ORG` / `SENTRY_PROJECT` from these vars at
# `vite build` time and skips source-map upload entirely when the token is
# missing (local dev).

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=nexo-app
SENTRY_PROJECT=nexo-desktop
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1

# Google Books API
VITE_GOOGLE_BOOKS_KEY= 

# Google OAuth (Drive connect)
# VITE_GOOGLE_OAUTH_CLIENT_ID is REQUIRED and must belong to a Desktop app
#   OAuth client (native 127.0.0.1 loopback redirect + PKCE).
# VITE_GOOGLE_OAUTH_CLIENT_SECRET is OPTIONAL: needed only for Web-type
#   clients. Leave it empty for a Desktop client using PKCE.
# Never put real values in this file.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_SECRET=