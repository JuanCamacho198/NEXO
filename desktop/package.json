{
  "name": "nexo-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "bun run check:lockstep && vite build",
    "check:lockstep": "bun run scripts/check-cfi-lockstep.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "tauri": "bunx tauri",
    "tauri:dev": "bunx tauri dev",
    "tauri:build": "bunx tauri build",
    "test": "vitest run",
    "test:e2e": "bunx playwright test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "rust:check": "cd src-tauri && cargo check",
    "rust:lint": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:test": "cd src-tauri && cargo test",
    "ci": "bun run check && bun run lint && bun run format:check && bun run rust:check && bun run rust:lint && bun run rust:fmt:check"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@fabianlars/tauri-plugin-oauth": "^2.1.0",
    "@internationalized/date": "^3.8.1",
    "@nexo/manifest-validator": "workspace:*",
    "@sentry/browser": "^10.53.1",
    "@supabase/supabase-js": "^2.110.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "bits-ui": "2.19.2",
    "boneyard-js": "^1.7.7",
    "epubjs": "0.3.93",
    "lucide-svelte": "^1.0.1",
    "pdfjs-dist": "6.2.108",
    "std-env": "4.2.0",
    "svelte": "5.56.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.2.9",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "bun-plugin-svelte": "^0.0.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "opencode-pencil-sync": "^0.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "svelte-check": "^4.7.2",
    "svelte-jester": "^5.0.0",
    "svelte-preprocess": "^6.0.3",
    "svelte-testing-library": "^1.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "vitest-svelte-kit": "^0.0.7"
  }
}
