---
import { Image } from 'astro:assets';
import step1a from '@/assets/steps/step1-a.png';
import step1b from '@/assets/steps/step1-b.png';
import step2a from '@/assets/steps/step2-a.png';
import step2b from '@/assets/steps/step2-b.png';
import step3a from '@/assets/steps/step3-a.png';
import step3b from '@/assets/steps/step3-b.png';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const steps = [
  {
    n: '01',
    kind: 'import',
    title: t('steps.s1Title'),
    copy: t('steps.s1Copy'),
    a: step1a,
    b: step1b,
  },
  {
    n: '02',
    kind: 'highlight',
    title: t('steps.s2Title'),
    copy: t('steps.s2Copy'),
    a: step2a,
    b: step2b,
  },
  {
    n: '03',
    kind: 'sync',
    title: t('steps.s3Title'),
    copy: t('steps.s3Copy'),
    a: step3a,
    b: step3b,
  },
] as const;
---

<!-- ══════════════ STEPS ══════════════ -->
<!-- Scrolling down moves this section sideways. The section is tall; its
     .steps-pin child is sticky, so it holds the screen while the visitor scrolls
     through it, and every animation inside runs on the section's view timeline
     (--steps) instead of the clock: scrolling plays it, scrolling back rewinds
     it. The timeline runs 0% → 100% exactly while the pin is held, and is cut
     into five beats:
        0–20%  card 1 plays its story      20–40%  slide to card 2
       40–60%  card 2 plays its story      60–80%  slide to card 3
       80–100% card 3 plays its story
     Without scroll-driven animation support (Firefox today) or under reduced
     motion, none of that applies and the three cards simply stack. -->
<section id="como-funciona" class="steps relative text-ink" data-theme="dark">
  <div class="steps-pin">
    <div class="steps-sky night-sky" aria-hidden="true"></div>

    <div class="shell steps-head text-center">
      <p class="steps-eyebrow">{t('header.navHow')}</p>
      <h2 class="steps-title">{t('steps.heading')}</h2>
      <p class="steps-lead">{t('steps.lead')}</p>
    </div>

    <ol class="steps-track" aria-label={t('steps.listAria')}>
      {steps.map((step) => (
        <li class={`step-card step-${step.kind}`}>
          <div class="step-scene" aria-hidden="true">
            <Image
              src={step.a}
              alt=""
              widths={[560, 1040]}
              sizes="(max-width: 640px) 80vw, 40vw"
              class="scene-img scene-a"
            />
            <Image
              src={step.b}
              alt=""
              widths={[560, 1040]}
              sizes="(max-width: 640px) 80vw, 40vw"
              class="scene-img scene-b"
            />
            {step.kind === 'import' && (
              <>
                <span class="file-chip">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M6 3h8l4 4v14H6Z" />
                    <path d="M14 3v4h4" />
                  </svg>
                  {t('steps.fileName')}
                </span>
                <span class="scene-toast">
                  <span class="toast-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                  </span>
                  <span>
                    <strong>{t('steps.importToastTitle')}</strong>
                    <small>{t('steps.importToastCopy')}</small>
                  </span>
                </span>
              </>
            )}
            {step.kind !== 'import' && (
              <span class="scene-chip">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                {step.kind === 'highlight' ? t('steps.cloudChip') : t('steps.syncChip')}
              </span>
            )}
          </div>
          <div class="step-text">
            <span class="step-number" aria-hidden="true">
              {step.n}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-copy">{step.copy}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="steps-progress" aria-hidden="true">
      <span class="progress-line">
        <span class="progress-fill"></span>
      </span>
      {steps.map((step, i) => (
        <span class={`progress-dot dot-${i + 1}`}>{step.n}</span>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── base: the stacked layout every browser gets ── */
  .steps {
    --steps-bg: #0d0b18;
    /* Starts on the exact colour the hero ends on (its sky fade, dimmed by
       the card's outer shadow, measures #070610) and eases to the section's
       own night blue, so there is no seam. */
    background: linear-gradient(to bottom, #070610, var(--steps-bg) 240px);
  }
  .steps-pin {
    position: relative;
    padding: 72px 0 112px;
    overflow: clip;
  }
  .steps-head {
    position: relative;
    max-width: 760px;
  }
  .steps-eyebrow {
    color: oklch(76% 0.16 55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .steps-title {
    margin-top: 14px;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    background: linear-gradient(
      100deg,
      oklch(97% 0.01 80),
      oklch(84% 0.08 60) 60%,
      oklch(74% 0.17 48)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .steps-lead {
    margin-top: 16px;
    font-size: 1.1rem;
    color: var(--color-ink-soft);
  }

  .steps-track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1080px;
    margin: 56px auto 0;
    padding: 0 24px;
  }
  .step-card {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: 24px;
    border: 1px solid oklch(100% 0 0 / 0.08);
    border-radius: 32px;
    background:
      radial-gradient(90% 90% at 30% 10%, oklch(70% 0.17 50 / 0.14), transparent 60%),
      oklch(17% 0.03 275 / 0.88);
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.06);
    overflow: hidden;
  }
  .step-scene {
    position: relative;
    height: 400px;
    margin: 28px 0 28px 28px;
  }
  /* Both states share one trimmed box, so B lands exactly on A. */
  .step-scene :global(.scene-img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    translate: -50% 0;
    filter: drop-shadow(0 24px 30px oklch(0% 0 0 / 0.55));
  }
  /* Stacked, each card shows its finished state. */
  .step-scene :global(.scene-a) {
    opacity: 0;
  }

  .file-chip,
  .scene-toast,
  .scene-chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid oklch(100% 0 0 / 0.14);
    background: oklch(20% 0.035 270 / 0.85);
    backdrop-filter: blur(12px);
    color: var(--color-ink);
    white-space: nowrap;
    box-shadow: 0 16px 32px -12px oklch(0% 0 0 / 0.7);
    opacity: 0;
  }
  .file-chip {
    left: 6%;
    top: 4%;
    padding: 10px 16px 10px 12px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 600;
  }
  .file-chip svg {
    width: 22px;
    height: 22px;
    color: oklch(80% 0.15 220);
  }
  .scene-toast {
    right: 0;
    top: 0;
    padding: 12px 18px 12px 12px;
    border-radius: 16px;
  }
  .scene-toast strong {
    display: block;
    font-size: 14px;
  }
  .scene-toast small {
    display: block;
    font-size: 12.5px;
    color: var(--color-ink-soft);
  }
  .toast-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: oklch(72% 0.17 155 / 0.2);
    color: oklch(80% 0.17 155);
  }
  .toast-icon svg,
  .scene-chip svg {
    width: 16px;
    height: 16px;
  }
  .scene-chip {
    left: 50%;
    top: 2%;
    translate: -50% 0;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }
  .scene-chip svg {
    color: oklch(80% 0.16 60);
  }

  .step-text {
    padding: 32px 40px 32px 8px;
  }
  .step-number {
    display: block;
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(100deg, oklch(97% 0.01 80), oklch(74% 0.17 48));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.85;
  }
  .step-title {
    margin-top: 12px;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: -0.02em;
  }
  .step-copy {
    margin-top: 10px;
    max-width: 34ch;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .steps-progress {
    display: none;
  }

  @media (max-width: 900px) {
    .step-card {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .step-scene {
      height: 280px;
      margin: 20px 20px 0;
    }
    .step-text {
      padding: 20px 24px 28px;
    }
    .step-number {
      font-size: 48px;
    }
    .scene-toast small {
      display: none;
    }
  }

  /* ── enhanced: pinned, sideways, scroll-driven ── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .steps {
        /* Five beats of ~60vh of scrolling each, plus the pinned screen. */
        height: 400svh;
        view-timeline-name: --steps;
        view-timeline-axis: block;
      }
      .steps-pin {
        position: sticky;
        top: 0;
        height: 100svh;
        padding: 0;
        display: flex;
        flex-direction: column;
        container-type: inline-size;
        /* Card geometry, in units of the pinned screen's width. --d is the
           distance from one card's centre to the next. */
        --card-w: 66cqw;
        --gap: 6cqw;
        --d: calc(var(--card-w) + var(--gap));
      }
      .steps-head {
        padding-top: clamp(92px, 13svh, 124px);
      }
      .steps-head .steps-lead {
        display: none;
      }
      .steps-title {
        font-size: clamp(2rem, 3.6vw, 3.2rem);
      }

      .steps-track {
        flex: 1;
        min-height: 0;
        flex-direction: row;
        align-items: center;
        gap: var(--gap);
        max-width: none;
        width: max-content;
        margin: 0;
        /* First card starts centred. */
        padding: 2svh calc((100cqw - var(--card-w)) / 2);
        animation: steps-slide linear both;
      }
      .step-card {
        width: var(--card-w);
        height: min(62svh, 560px);
        flex: none;
      }
      .step-scene {
        height: calc(100% - 56px);
      }

      .steps-progress {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(560px, 70cqw);
        margin: 0 auto clamp(20px, 4svh, 40px);
      }
      .progress-line {
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 2px;
        border-radius: 2px;
        background: oklch(100% 0 0 / 0.12);
      }
      .progress-fill {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: oklch(72% 0.18 50);
        box-shadow: 0 0 10px oklch(72% 0.18 50 / 0.8);
        transform-origin: left;
        animation: progress-fill linear both;
      }
      .progress-dot {
        position: relative;
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border: 1px solid oklch(100% 0 0 / 0.16);
        border-radius: 50%;
        background: var(--steps-bg);
        color: var(--color-ink-soft);
        font-size: 12px;
        font-weight: 700;
        animation: dot-on linear both;
      }
      .progress-dot.dot-2 {
        animation-name: dot-on-2;
      }
      .progress-dot.dot-3 {
        animation-name: dot-on-3;
      }

      /* Every animation below runs on the section's pinned scroll range. */
      .steps-track,
      .steps-sky,
      .progress-fill,
      .progress-dot,
      .step-scene,
      .step-text,
      .step-scene :global(.scene-b),
      .file-chip,
      .scene-toast,
      .scene-chip {
        animation-timeline: --steps;
        animation-range: contain 0% contain 100%;
        animation-fill-mode: both;
      }

      /* Parallax: the far sky drifts slowly; inside each card the device
         travels further than the card itself and the text a little less,
         so the three planes separate as a card slides in or out. */
      .steps-sky {
        inset: 0 auto 0 0;
        width: 160cqw;
        animation-name: sky-drift;
        animation-timing-function: linear;
      }
      .step-scene {
        --shift: 13cqw;
      }
      .step-text {
        --shift: 4cqw;
      }
      .step-import .step-scene,
      .step-import .step-text {
        animation-name: depth-1;
        animation-timing-function: linear;
      }
      .step-highlight .step-scene,
      .step-highlight .step-text {
        animation-name: depth-2;
        animation-timing-function: linear;
      }
      .step-sync .step-scene,
      .step-sync .step-text {
        animation-name: depth-3;
        animation-timing-function: linear;
      }

      /* The stories, each placed on its card's beat. */
      .step-scene :global(.scene-a) {
        opacity: 1;
      }
      .step-scene :global(.scene-b) {
        opacity: 0;
        animation-timing-function: linear;
      }
      .step-import :global(.scene-b) {
        animation-name: swap-1;
      }
      .step-highlight :global(.scene-b) {
        animation-name: swap-2;
      }
      .step-sync :global(.scene-b) {
        animation-name: swap-3;
      }
      .file-chip {
        animation-name: file-drop;
        animation-timing-function: linear;
      }
      .scene-toast {
        animation-name: toast-1;
        animation-timing-function: linear;
      }
      .step-highlight .scene-chip {
        animation-name: chip-2;
        animation-timing-function: linear;
      }
      .step-sync .scene-chip {
        animation-name: chip-3;
        animation-timing-function: linear;
      }

      @media (max-width: 900px) {
        .steps {
          height: 360svh;
        }
        .steps-pin {
          --card-w: 84cqw;
          --gap: 4cqw;
        }
        .step-card {
          height: min(66svh, 600px);
          grid-template-rows: 1fr auto;
        }
        /* Stretch into the 1fr row: the images are absolutely positioned, so
           the scene has no height of its own to centre with. */
        .step-scene {
          align-self: stretch;
          height: auto;
          min-height: 0;
          margin: 16px 16px 0;
        }
      }
    }
  }

  /* Track: hold, slide, hold, slide, hold (the five beats). */
  @keyframes steps-slide {
    0%,
    20% {
      transform: none;
    }
    40%,
    60% {
      transform: translateX(calc(var(--d) * -1));
    }
    80%,
    100% {
      transform: translateX(calc(var(--d) * -2));
    }
  }
  @keyframes sky-drift {
    to {
      transform: translateX(-60cqw);
    }
  }
  @keyframes depth-1 {
    0%,
    20% {
      translate: 0 0;
    }
    40%,
    100% {
      translate: calc(var(--shift) * -1) 0;
    }
  }
  @keyframes depth-2 {
    0%,
    20% {
      translate: var(--shift) 0;
    }
    40%,
    60% {
      translate: 0 0;
    }
    80%,
    100% {
      translate: calc(var(--shift) * -1) 0;
    }
  }
  @keyframes depth-3 {
    0%,
    60% {
      translate: var(--shift) 0;
    }
    80%,
    100% {
      translate: 0 0;
    }
  }
  /* The fill reaches each dot as its card arrives, and holds there. */
  @keyframes progress-fill {
    0%,
    20% {
      transform: scaleX(0);
    }
    40%,
    60% {
      transform: scaleX(0.5);
    }
    80%,
    100% {
      transform: scaleX(1);
    }
  }
  @keyframes dot-on {
    0%,
    100% {
      border-color: oklch(72% 0.18 50);
      color: var(--color-ink);
      box-shadow: 0 0 14px oklch(72% 0.18 50 / 0.6);
    }
  }
  @keyframes dot-on-2 {
    0%,
    38% {
      border-color: oklch(100% 0 0 / 0.16);
      color: var(--color-ink-soft);
      box-shadow: none;
    }
    40%,
    100% {
      border-color: oklch(72% 0.18 50);
      color: var(--color-ink);
      box-shadow: 0 0 14px oklch(72% 0.18 50 / 0.6);
    }
  }
  @keyframes dot-on-3 {
    0%,
    78% {
      border-color: oklch(100% 0 0 / 0.16);
      color: var(--color-ink-soft);
      box-shadow: none;
    }
    80%,
    100% {
      border-color: oklch(72% 0.18 50);
      color: var(--color-ink);
      box-shadow: 0 0 14px oklch(72% 0.18 50 / 0.6);
    }
  }

  /* Card 1 (0–20%): the file drops in, the screen turns into the book's
     detail sheet, the "imported" toast lands and clears as the card leaves. */
  @keyframes file-drop {
    0%,
    1% {
      opacity: 0;
      transform: translate(-30px, -40px) rotate(-8deg);
    }
    3% {
      opacity: 1;
      transform: translate(-10px, -10px) rotate(-4deg);
    }
    9% {
      opacity: 1;
      transform: translate(150px, 150px) scale(0.7);
    }
    11%,
    100% {
      opacity: 0;
      transform: translate(160px, 170px) scale(0.5);
    }
  }
  @keyframes swap-1 {
    0%,
    9% {
      opacity: 0;
    }
    13%,
    100% {
      opacity: 1;
    }
  }
  @keyframes toast-1 {
    0%,
    11% {
      opacity: 0;
      transform: translateY(-12px) scale(0.96);
    }
    14%,
    26% {
      opacity: 1;
      transform: none;
    }
    32%,
    100% {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  /* Card 2 (40–60%): the passage gets highlighted, then "saved everywhere". */
  @keyframes swap-2 {
    0%,
    43% {
      opacity: 0;
    }
    49%,
    100% {
      opacity: 1;
    }
  }
  @keyframes chip-2 {
    0%,
    49% {
      opacity: 0;
      transform: translateY(-10px);
    }
    53%,
    66% {
      opacity: 1;
      transform: none;
    }
    72%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  /* Card 3 (80–100%): the phone opens the book at the same line. */
  @keyframes swap-3 {
    0%,
    83% {
      opacity: 0;
    }
    89%,
    100% {
      opacity: 1;
    }
  }
  @keyframes chip-3 {
    0%,
    89% {
      opacity: 0;
      transform: translateY(-10px);
    }
    93%,
    100% {
      opacity: 1;
      transform: none;
    }
  }
</style>
