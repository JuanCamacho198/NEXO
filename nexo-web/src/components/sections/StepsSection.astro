---
import { Image } from 'astro:assets';
import step1a from '@/assets/steps/step1-a.png';
import step1b from '@/assets/steps/step1-b.png';
import step2a from '@/assets/steps/step2-a.png';
import step2b from '@/assets/steps/step2-b.png';
import step3a from '@/assets/steps/step3-a.png';
import step3b from '@/assets/steps/step3-b.png';
import bookFlip1 from '@/assets/hero/books/book-flip-1.png';
import bookFlip2 from '@/assets/hero/books/book-flip-2.png';
import bookFlip4 from '@/assets/hero/books/book-flip-4.png';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const steps = [
  {
    n: '01',
    kind: 'import',
    short: t('steps.s1Short'),
    title: t('steps.s1Title'),
    copy: t('steps.s1Copy'),
    a: step1a,
    b: step1b,
  },
  {
    n: '02',
    kind: 'highlight',
    short: t('steps.s2Short'),
    title: t('steps.s2Title'),
    copy: t('steps.s2Copy'),
    a: step2a,
    b: step2b,
  },
  {
    n: '03',
    kind: 'sync',
    short: t('steps.s3Short'),
    title: t('steps.s3Title'),
    copy: t('steps.s3Copy'),
    a: step3a,
    b: step3b,
  },
] as const;

// The hero's floating books, carried into this section's night: far, soft and
// at the edges, so they never sit behind the copy.
const books = [bookFlip1, bookFlip4, bookFlip2];
---

<!-- ══════════════ STEPS ══════════════ -->
<!-- Scrolling down moves this section sideways. The section is tall; its
     .steps-pin child is sticky, so it holds the screen while the visitor scrolls
     through it, and every animation inside runs on the section's view timeline
     (--steps) instead of the clock: scrolling plays it, scrolling back rewinds
     it. The timeline runs 0% → 100% exactly while the pin is held, and is cut
     into five beats:
        0–20%  card 1 plays its story      20–40%  slide to card 2
       40–60%  card 2 plays its story      60–80%  slide to card 3
       80–100% card 3 plays its story
     Without scroll-driven animation support (Firefox today) or under reduced
     motion, none of that applies and the three cards simply stack. -->
<section id="como-funciona" class="steps relative text-ink" data-theme="dark">
  <div class="steps-pin">
    <div class="steps-sky night-sky" aria-hidden="true"></div>
    <div class="steps-decor" aria-hidden="true">
      {books.map((src, i) => (
        <div class={`steps-book steps-book-${i + 1}`}>
          <Image src={src} alt="" widths={[240, 480]} sizes="18vw" loading="lazy" />
        </div>
      ))}
      {[1, 2, 3, 4].map((i) => (
        <svg class={`sparkle sparkle-${i}`} viewBox="0 0 24 24">
          <path d="M12 0c.9 6.6 5.4 11.1 12 12-6.6.9-11.1 5.4-12 12-.9-6.6-5.4-11.1-12-12C6.6 11.1 11.1 6.6 12 0Z" />
        </svg>
      ))}
    </div>

    <div class="shell steps-head text-center">
      <p class="steps-eyebrow eyebrow-rule">{t('header.navHow')}</p>
      <h2 class="steps-title title-split">
        {t('steps.heading')}{' '}
        <span class="title-accent">
          {t('steps.headingAccent')}
          <svg
            class="title-swoosh"
            viewBox="0 0 300 24"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M4 18C70 7 170 3 296 9" />
          </svg>
        </span>
      </h2>
      <p class="steps-lead">{t('steps.lead')}</p>
    </div>

    <ol class="steps-track" aria-label={t('steps.listAria')}>
      {steps.map((step) => (
        <li class={`step-card step-${step.kind}`}>
          <div class="step-scene" aria-hidden="true">
            <Image
              src={step.a}
              alt=""
              widths={[640, 1040, 1600]}
              sizes="(max-width: 640px) 90vw, 45vw"
              class="scene-img scene-a"
            />
            <Image
              src={step.b}
              alt=""
              widths={[640, 1040, 1600]}
              sizes="(max-width: 640px) 90vw, 45vw"
              class="scene-img scene-b"
            />
            {step.kind === 'import' && (
              <>
                <!-- The formats NEXO opens, as small 3D tiles orbiting the
                     laptop. Format names, not copy: the same in every language. -->
                <span class="format-tile tile-epub">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2.5 5.5c3-1.2 6.5-1 9.5 1 3-2 6.5-2.2 9.5-1v13c-3-1.2-6.5-1-9.5 1-3-2-6.5-2.2-9.5-1Z" />
                    <path d="M12 6.5v13" />
                  </svg>
                  EPUB
                </span>
                <span class="format-tile tile-pdf">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M6 2.5h8l4.5 4.5v14.5H6Z" />
                    <path d="M14 2.5V7h4.5" />
                    <path d="M9 13h6M9 16.5h4" />
                  </svg>
                  PDF
                </span>
                <span class="file-chip">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M6 3h8l4 4v14H6Z" />
                    <path d="M14 3v4h4" />
                  </svg>
                  {t('steps.fileName')}
                </span>
                <span class="scene-toast">
                  <span class="toast-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m5 12.5 4.5 4.5L19 7.5" />
                    </svg>
                  </span>
                  <span>
                    <strong>{t('steps.importToastTitle')}</strong>
                    <small>{t('steps.importToastCopy')}</small>
                  </span>
                </span>
              </>
            )}
            {step.kind !== 'import' && (
              <span class="scene-chip">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
                {step.kind === 'highlight' ? t('steps.cloudChip') : t('steps.syncChip')}
              </span>
            )}
          </div>
          <div class="step-text">
            <span class="step-number" aria-hidden="true">
              {step.n}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-copy">{step.copy}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- Progress rail: a line with one icon stop per card. The fill grows on
         the same scroll timeline as the cards, a glowing head rides its tip,
         and each stop lights up as the head reaches it. -->
    <div class="steps-progress" aria-hidden="true">
      <span class="progress-line">
        <span class="progress-fill">
          <span class="progress-head"></span>
        </span>
      </span>
      {steps.map((step, i) => (
        <span class={`progress-stop stop-${i + 1}`}>
          <span class="progress-dot">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {step.kind === 'import' ? (
                <>
                  <path d="M7 17.5a4.5 4.5 0 0 1-.6-9 6 6 0 0 1 11.4 1.6A3.8 3.8 0 0 1 17.5 17.5" />
                  <path d="M12 12v8M9 15l3-3 3 3" />
                </>
              ) : step.kind === 'highlight' ? (
                <>
                  <path d="M2.5 5.5c3-1.2 6.5-1 9.5 1 3-2 6.5-2.2 9.5-1v13c-3-1.2-6.5-1-9.5 1-3-2-6.5-2.2-9.5-1Z" />
                  <path d="M12 6.5v13" />
                </>
              ) : (
                <>
                  <path d="M20 11a8 8 0 0 0-14.3-4.6L4 8" />
                  <path d="M4 3.5V8h4.5" />
                  <path d="M4 13a8 8 0 0 0 14.3 4.6L20 16" />
                  <path d="M20 20.5V16h-4.5" />
                </>
              )}
            </svg>
          </span>
          <span class="progress-label">{step.short}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── base: the stacked layout every browser gets ── */
  .steps {
    --steps-bg: #0d0b18;
    /* Starts on the exact colour the hero ends on (its sky fade, dimmed by
       the card's outer shadow, measures #070610) and eases to the section's
       own night blue, so there is no seam. */
    background: linear-gradient(to bottom, #070610, var(--steps-bg) 240px);
  }
  .steps-pin {
    position: relative;
    padding: 72px 0 112px;
    overflow: clip;
  }
  .steps-head {
    position: relative;
    max-width: 760px;
  }
  .steps-eyebrow {
    justify-content: center;
    color: oklch(76% 0.16 55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  /* Weight, colour and the accent come from .title-split (global.css). */
  .steps-title {
    margin-top: 14px;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
  }
  .steps-lead {
    margin-top: 16px;
    font-size: 1.1rem;
    color: var(--color-ink-soft);
  }

  .steps-track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1080px;
    margin: 56px auto 0;
    padding: 0 24px;
  }
  /* No card box: each step floats in the night like the hero's devices. */
  .step-card {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: 24px;
  }
  /* The laptop is the widest device: it gets more of the card and may spill a
     little past its scene, so it reads at the same weight as the tablet. */
  .step-import {
    grid-template-columns: 1.55fr 1fr;
  }
  .step-import .step-scene :global(.scene-img) {
    max-width: 114%;
    max-height: 114%;
  }
  .step-scene {
    position: relative;
    isolation: isolate;
    height: 400px;
    margin: 28px 0 28px 28px;
  }
  /* A soft shadow under the device, the anchor the card box used to be, with
     a faint warm pool so it ties to the night's orange. Painted first, so the
     device stands on it. */
  .step-scene::before {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -3%;
    height: 16%;
    border-radius: 50%;
    background:
      radial-gradient(
        closest-side,
        oklch(4% 0.01 270 / 0.75),
        oklch(4% 0.01 270 / 0.3) 60%,
        transparent
      ),
      radial-gradient(closest-side, oklch(70% 0.17 50 / 0.12), transparent 80%);
    filter: blur(6px);
    pointer-events: none;
  }

  /* Format tiles: small chunky 3D squares, a darker underside for thickness. */
  .format-tile {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    width: 84px;
    aspect-ratio: 1;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.04em;
    transform: perspective(420px) rotateX(16deg) rotateY(var(--ry)) rotate(var(--rz));
    animation: tile-float 4.8s ease-in-out infinite alternate;
  }
  .format-tile svg {
    width: 30px;
    height: 30px;
  }
  .tile-epub {
    --ry: 22deg;
    --rz: -12deg;
    left: -1%;
    top: 46%;
    background: linear-gradient(150deg, oklch(82% 0.15 66), oklch(64% 0.2 42));
    color: oklch(99% 0.01 80);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.45),
      0 7px 0 oklch(47% 0.15 38),
      0 22px 34px -10px oklch(68% 0.19 45 / 0.75);
  }
  .tile-pdf {
    --ry: -24deg;
    --rz: 10deg;
    right: -3%;
    bottom: 20%;
    width: 72px;
    background: linear-gradient(150deg, oklch(99% 0.005 80), oklch(88% 0.02 70));
    color: oklch(56% 0.21 27);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.8),
      0 6px 0 oklch(70% 0.03 60),
      0 22px 34px -12px oklch(0% 0 0 / 0.6);
    animation-delay: -2.4s;
  }

  /* Floating books and sparkles behind everything. */
  .steps-decor {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .steps-book {
    --tilt: 0deg;
    --drift-y: -12px;
    --drift-r: 3deg;
    position: absolute;
    rotate: var(--tilt);
    animation: book-drift 12s ease-in-out infinite alternate;
  }
  .steps-book :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .steps-book-1 {
    --tilt: -16deg;
    left: -2%;
    top: 14%;
    width: 10%;
    opacity: 0.7;
    filter: blur(1.5px);
    animation-duration: 14s;
  }
  .steps-book-2 {
    --tilt: 12deg;
    left: -4%;
    bottom: -4%;
    width: 17%;
    opacity: 0.85;
    filter: blur(0.5px) drop-shadow(0 20px 26px oklch(0% 0 0 / 0.5));
    animation-delay: -5s;
  }
  .steps-book-3 {
    --tilt: 14deg;
    right: -3%;
    top: 34%;
    width: 12%;
    opacity: 0.7;
    filter: blur(1.2px);
    animation-duration: 15s;
    animation-delay: -8s;
  }
  .sparkle {
    position: absolute;
    width: 16px;
    height: 16px;
    fill: oklch(80% 0.15 60);
    filter: drop-shadow(0 0 6px oklch(74% 0.18 52 / 0.9));
    animation: twinkle 3.6s ease-in-out infinite;
  }
  .sparkle-1 {
    left: 12%;
    top: 30%;
  }
  .sparkle-2 {
    left: 44%;
    top: 24%;
    width: 11px;
    height: 11px;
    animation-delay: -1.2s;
  }
  .sparkle-3 {
    left: 18%;
    top: 72%;
    width: 12px;
    height: 12px;
    animation-delay: -2.1s;
  }
  .sparkle-4 {
    right: 14%;
    top: 22%;
    animation-delay: -0.6s;
  }
  /* Both states share one trimmed box, so B lands exactly on A. */
  .step-scene :global(.scene-img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    translate: -50% 0;
    filter: drop-shadow(0 24px 30px oklch(0% 0 0 / 0.55));
  }
  /* Stacked, each card shows its finished state. */
  .step-scene :global(.scene-a) {
    opacity: 0;
  }

  .file-chip,
  .scene-toast,
  .scene-chip {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid oklch(100% 0 0 / 0.14);
    background: oklch(20% 0.035 270 / 0.85);
    backdrop-filter: blur(12px);
    color: var(--color-ink);
    white-space: nowrap;
    box-shadow: 0 16px 32px -12px oklch(0% 0 0 / 0.7);
    opacity: 0;
  }
  .file-chip {
    left: 6%;
    top: 4%;
    padding: 10px 16px 10px 12px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 600;
  }
  .file-chip svg {
    width: 22px;
    height: 22px;
    color: oklch(80% 0.15 220);
  }
  .scene-toast {
    right: 0;
    top: 0;
    padding: 12px 18px 12px 12px;
    border-radius: 16px;
  }
  .scene-toast strong {
    display: block;
    font-size: 14px;
  }
  .scene-toast small {
    display: block;
    font-size: 12.5px;
    color: var(--color-ink-soft);
  }
  .toast-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: oklch(72% 0.17 155 / 0.2);
    color: oklch(80% 0.17 155);
  }
  .toast-icon svg,
  .scene-chip svg {
    width: 16px;
    height: 16px;
  }
  .scene-chip {
    left: 50%;
    top: 2%;
    translate: -50% 0;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }
  /* Above the tablet, not over its top bar. */
  .step-highlight .scene-chip {
    top: -9%;
  }
  .scene-chip svg {
    color: oklch(80% 0.16 60);
  }

  .step-text {
    padding: 32px 40px 32px 8px;
  }
  /* The number steps back into a small glowing badge so the title leads. */
  .step-number {
    display: inline-block;
    padding: 8px 16px;
    border: 1.5px solid oklch(74% 0.17 52 / 0.55);
    border-radius: 16px;
    background: oklch(72% 0.17 50 / 0.08);
    box-shadow:
      0 0 24px -6px oklch(72% 0.18 50 / 0.6),
      inset 0 0 14px oklch(72% 0.18 50 / 0.12);
    color: oklch(80% 0.15 58);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .step-title {
    margin-top: 20px;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .step-copy {
    margin-top: 12px;
    max-width: 40ch;
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .steps-progress {
    display: none;
  }

  @media (max-width: 900px) {
    .step-card {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .step-scene {
      height: 280px;
      margin: 20px 20px 0;
    }
    .step-text {
      padding: 20px 24px 28px;
    }
    .step-number {
      font-size: 26px;
    }
    .format-tile {
      width: 60px;
      border-radius: 15px;
      font-size: 11px;
    }
    .format-tile svg {
      width: 22px;
      height: 22px;
    }
    .tile-pdf {
      width: 52px;
    }
    .steps-book-1,
    .steps-book-3 {
      display: none;
    }
    .steps-book-2 {
      left: -14%;
      bottom: -9%;
      width: 28%;
      opacity: 0.55;
    }
    .scene-toast small {
      display: none;
    }
  }

  /* ── enhanced: pinned, sideways, scroll-driven ── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .steps {
        /* Five beats of ~60vh of scrolling each, plus the pinned screen. */
        height: 400svh;
        view-timeline-name: --steps;
        view-timeline-axis: block;
      }
      .steps-pin {
        position: sticky;
        top: 0;
        height: 100svh;
        padding: 0;
        display: flex;
        flex-direction: column;
        container-type: inline-size;
        /* Card geometry, in units of the pinned screen's width. --d is the
           distance from one card's centre to the next. */
        --card-w: 66cqw;
        /* Wide enough that the next step stays off screen: without a card box
           a half-visible device reads as cut off. */
        --gap: 20cqw;
        --d: calc(var(--card-w) + var(--gap));
      }
      .steps-head {
        padding-top: clamp(92px, 13svh, 124px);
      }
      .steps-head .steps-lead {
        display: none;
      }
      .steps-title {
        font-size: clamp(2rem, 3.6vw, 3.2rem);
      }

      .steps-track {
        flex: 1;
        min-height: 0;
        flex-direction: row;
        align-items: center;
        gap: var(--gap);
        max-width: none;
        width: max-content;
        /* Clears the heading: the cards are vertically centred in the pinned
           screen, and without this gap the tallest ones grow up into the
           title. The margin is taken out of the track's own flex space, so it
           never pushes the progress rail off the bottom. */
        margin: clamp(20px, 4svh, 44px) 0 0;
        /* First card starts centred. */
        padding: 2svh calc((100cqw - var(--card-w)) / 2);
        animation: steps-slide linear both;
      }
      .step-card {
        width: var(--card-w);
        height: min(62svh, 560px);
        /* Never taller than the room between the heading and the rail, so a
           short screen shrinks the card instead of overlapping either. */
        max-height: 100%;
        flex: none;
      }
      .step-scene {
        height: calc(100% - 56px);
      }

      .steps-progress {
        /* Wide enough for the end labels, centred under their dots. */
        --rail-inset: 46px;
        --stop: 40px;
        position: relative;
        display: flex;
        justify-content: space-between;
        width: min(620px, 82cqw);
        margin: clamp(14px, 2.4svh, 24px) auto clamp(16px, 3svh, 32px);
        padding: 0 var(--rail-inset);
      }
      /* The line runs icon-centre to icon-centre, at the icons' mid-height. */
      .progress-line {
        position: absolute;
        left: calc(var(--rail-inset) + var(--stop) / 2);
        right: calc(var(--rail-inset) + var(--stop) / 2);
        top: calc(var(--stop) / 2 - 1px);
        height: 2px;
        border-radius: 2px;
        background: oklch(100% 0 0 / 0.1);
      }
      /* Width, not scaleX: the head is a child pinned to the tip, and a scaled
         parent would squash it. */
      .progress-fill {
        position: absolute;
        inset: 0 auto 0 0;
        border-radius: inherit;
        background: linear-gradient(90deg, oklch(72% 0.18 50 / 0.35), oklch(74% 0.18 52));
        animation: progress-fill linear both;
      }
      .progress-head {
        position: absolute;
        right: -5px;
        top: 50%;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        translate: 0 -50%;
        background: oklch(96% 0.06 80);
        box-shadow:
