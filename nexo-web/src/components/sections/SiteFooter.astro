---
import Logo from '@/components/ui/Logo.astro';
import { defaultLang, localizePath, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const footerLink = 'transition-[color] duration-[180ms] ease-[ease] hover:text-ink';
// Home-anchored, like the header, so the links also work from the legal pages.
const home = localizePath('/', lang);
---

<!-- ══════════════ FOOTER ══════════════ -->
<footer class="border-t border-t-border bg-background">
  <div class="shell flex items-center gap-[30px] py-8 max-[640px]:flex-col max-[640px]:items-start max-[640px]:gap-4 max-[640px]:py-[26px]">
    <Logo />

    <nav
      class="ml-auto flex gap-6 text-[14px] font-medium text-ink-soft max-[640px]:ml-0 max-[640px]:flex-wrap max-[640px]:gap-4"
      aria-label={t('footer.navAria')}
    >
      <a class={footerLink} href={`${home}#descargar`}>
        {t('footer.download')}
      </a>
      <a class={footerLink} href={`${home}#caracteristicas`}>
        {t('header.navFeatures')}
      </a>
      <a class={footerLink} href={`${home}#faq`}>
        {t('faq.title')}
      </a>
      <a class={footerLink} href={localizePath('/privacidad', lang)}>
        {t('footer.privacy')}
      </a>
      <a class={footerLink} href={localizePath('/terminos', lang)}>
        {t('footer.terms')}
      </a>
      <a class={footerLink} href="https://github.com/JuanCamacho198/NEXO">
        {t('footer.github')}
      </a>
    </nav>
  </div>
  <!-- Required by the CC BY 4.0 licence of the two hero device models (the
       iPhone model is Sketchfab Standard, which needs no credit). -->
  <p class="shell pb-6 text-[12px] text-muted-foreground">
    {t('footer.creditsLead')}
    <a
      class={footerLink}
      href="https://sketchfab.com/3d-models/laptop-7d870e900889481395b4a575b9fa8c3e"
    >
      {t('footer.creditLaptop')}
    </a>
    ·
    <a
      class={footerLink}
      href="https://sketchfab.com/3d-models/ipad-pro-129-2020-f0f7674522124f3bbc2d0f898963457e"
    >
      {t('footer.creditIpad')}
    </a>
    ·
    <a class={footerLink} href="https://creativecommons.org/licenses/by/4.0/">
      {t('footer.creditsLicense')}
    </a>
  </p>
</footer>
