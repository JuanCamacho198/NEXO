---
import { Image, Picture } from 'astro:assets';
import {
  heroSky,
  HERO_SKY_WIDTHS,
  HERO_SKY_SIZES,
  HERO_SKY_QUALITY,
} from '@/components/sections/hero-sky';
import deviceLaptop from '@/assets/hero/screen-laptop-v2.png';
import devicePhone from '@/assets/hero/screen-phone-v2.png';
import deviceTablet from '@/assets/hero/screen-tablet-v2.png';
import bookFlip1 from '@/assets/hero/books/book-flip-1.png';
import bookFlip2 from '@/assets/hero/books/book-flip-2.png';
import bookFlip3 from '@/assets/hero/books/book-flip-3.png';
import bookFlip4 from '@/assets/hero/books/book-flip-4.png';
import bookFlip5 from '@/assets/hero/books/book-flip-5.png';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const highlights = [
  { title: t('heroBar.syncTitle'), copy: t('heroBar.syncCopy'), icon: 'devices' },
  { title: t('heroBar.organizeTitle'), copy: t('heroBar.organizeCopy'), icon: 'bookmark' },
  { title: t('heroBar.readTitle'), copy: t('heroBar.readCopy'), icon: 'bolt' },
] as const;

// Sync ring segments in the stage's 1000×600 viewBox (see the markup note).
const ringA = 'M650 168 C800 150 990 214 988 330';
// Stacked, the wordmark is larger and the O sits further right and higher,
// so the first segment gets its own start (swapped in by CSS below 1024px).
const ringAMobile = 'M800 122 C910 140 992 232 988 330';
const ringB = 'M988 330 C986 452 760 562 470 562 C200 562 26 500 30 420';
const ringC = 'M30 420 C34 362 140 322 300 298';
const ringD = 'M300 298 C440 276 600 290 690 330';
// Floating books behind the devices; placement and depth live in the CSS
// (.hero-book-1 … 5). The last three are desktop-only.
const books = [bookFlip1, bookFlip3, bookFlip2, bookFlip4, bookFlip5];

// Measured with getTotalLength(); update them whenever a path changes.
const ringLen = { a: 414, aMobile: 306, b: 1100, c: 311, d: 396 };
---

<!-- ══════════════ HERO ══════════════ -->
<!-- Always dark, whatever theme the visitor picked: the sky only reads at night.
     The intro timeline (the `.hero-intro` delays and keyframes) lives in
     global.css next to the header's, because the header is part of it. -->
<section
  id="top"
  class="hero relative isolate overflow-hidden bg-[#0d0b18] text-ink"
  data-theme="dark"
>
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true">
    <!-- The width list is literal on purpose. astro:assets only builds the
         AVIF/WebP <source> set for literal array props; passing an expression
         (the previous `[768, 1280, heroSky.width]`) makes it fall back to a
         single unoptimized PNG, which shipped 482 KB as the LCP image.
         The values come from hero-sky.ts so the head preload in Layout matches
         this element exactly. -->
    <Picture
      src={heroSky}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1470]}
      sizes={HERO_SKY_SIZES}
      quality={HERO_SKY_QUALITY}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-[50%_100%]"
    />
  </div>

  <div class="hero-card relative flex flex-col">
    <div class="hero-stage relative min-h-0 flex-1" id="dispositivos">
      <!-- Renders of a Sketchfab book model (tools/device-renders), drifting
           in the sky at different depths: the far ones are smaller, blurred
           and move less with the pointer. Decorative. -->
      {books.map((src, i) => (
        <div class={`hero-book hero-book-${i + 1}`} aria-hidden="true">
          <Image src={src} alt="" widths={[240, 480]} sizes="16vw" loading="lazy" />
        </div>
      ))}

      <h1 class="hero-word">{t('hero.wordmark')}</h1>

      <!-- Sync ring. One open loop in four segments: it leaves the orange O of
           the wordmark (a), sweeps behind the tablet and around its right side,
           crosses in front of the three devices low down (b), turns and rises
           behind the phone (c), then passes behind the laptop and ends at the
           tablet (d). Only b sits in front of the devices. A light runs
           a → b → c → d. preserveAspectRatio="none" lets it stretch with the
           stage. --len is each path's length in user units; the dash keyframes
           in global.css are built on it (see the note there on pathLength). -->
      <svg
        class="hero-ring hero-ring-back"
        viewBox="0 0 1000 600"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient
            id="ring-a"
            gradientUnits="userSpaceOnUse"
            x1="650"
            y1="0"
            x2="990"
            y2="0"
          >
            <stop offset="0" stop-color="oklch(92% 0.1 70)" stop-opacity="0" />
            <stop offset="0.08" stop-color="oklch(92% 0.1 70)" />
            <stop offset="0.45" stop-color="oklch(74% 0.17 52)" stop-opacity="0.55" />
            <stop offset="1" stop-color="oklch(80% 0.16 58)" stop-opacity="0.95" />
          </linearGradient>
          <linearGradient
            id="ring-a-m"
            gradientUnits="userSpaceOnUse"
            x1="800"
            y1="0"
            x2="990"
            y2="0"
          >
            <stop offset="0" stop-color="oklch(92% 0.1 70)" stop-opacity="0" />
            <stop offset="0.1" stop-color="oklch(92% 0.1 70)" />
            <stop offset="0.5" stop-color="oklch(74% 0.17 52)" stop-opacity="0.6" />
            <stop offset="1" stop-color="oklch(80% 0.16 58)" stop-opacity="0.95" />
          </linearGradient>
          <!-- Brightest where it rises behind the phone. -->
          <linearGradient id="ring-c" gradientUnits="userSpaceOnUse" x1="30" y1="0" x2="300" y2="0">
            <stop offset="0" stop-color="oklch(76% 0.16 55)" stop-opacity="0.7" />
            <stop offset="0.6" stop-color="oklch(90% 0.12 68)" />
            <stop offset="1" stop-color="oklch(80% 0.16 58)" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient
            id="ring-d"
            gradientUnits="userSpaceOnUse"
            x1="300"
            y1="0"
            x2="690"
            y2="0"
          >
            <stop offset="0" stop-color="oklch(80% 0.16 58)" stop-opacity="0.85" />
            <stop offset="1" stop-color="oklch(74% 0.17 52)" stop-opacity="0.5" />
          </linearGradient>
        </defs>
        <path class="ring-glow ring-desk" stroke="url(#ring-a)" d={ringA} />
        <path class="ring-glow ring-mob" stroke="url(#ring-a-m)" d={ringAMobile} />
        <path class="ring-glow" stroke="url(#ring-c)" d={ringC} />
        <path class="ring-glow" stroke="url(#ring-d)" d={ringD} />
        <path
          class="ring-line ring-a ring-desk"
          stroke="url(#ring-a)"
          d={ringA}
          style={`--len:${ringLen.a}`}
        />
        <path
          class="ring-line ring-a ring-mob"
          stroke="url(#ring-a-m)"
          d={ringAMobile}
          style={`--len:${ringLen.aMobile}`}
        />
        <path
          class="ring-line ring-c"
          stroke="url(#ring-c)"
          d={ringC}
          style={`--len:${ringLen.c}`}
        />
        <path
          class="ring-line ring-d"
          stroke="url(#ring-d)"
          d={ringD}
          style={`--len:${ringLen.d}`}
        />
        <path class="ring-comet ring-a ring-desk" d={ringA} style={`--len:${ringLen.a}`} />
        <path
          class="ring-comet ring-a ring-mob"
          d={ringAMobile}
          style={`--len:${ringLen.aMobile}`}
        />
        <path class="ring-comet ring-c" d={ringC} style={`--len:${ringLen.c}`} />
        <path class="ring-comet ring-d" d={ringD} style={`--len:${ringLen.d}`} />
      </svg>

      <!-- 3D renders (transparent PNG) of the Sketchfab models, each showing a
           different part of the app, redrawn in tools/device-renders/screens.html
           with large type: the phone's "Today" (streak, goal, week), the
           laptop's library continuing La Odisea, the tablet's reader with a
           word looked up. Decorative: the copy around them says what they show. -->
      <div class="hero-device hero-device-laptop" aria-hidden="true">
        <Image
          src={deviceLaptop}
          alt=""
          widths={[640, 960, 1314]}
          sizes="(max-width: 1023px) 70vw, 46vw"
          loading="eager"
          class="block h-auto w-full"
        />
      </div>
      <div class="hero-device hero-device-phone" aria-hidden="true">
        <Image
          src={devicePhone}
          alt=""
          widths={[320, 605]}
          sizes="(max-width: 1023px) 26vw, 16vw"
          loading="eager"
          class="block h-auto w-full"
        />
        <span class="sync-chip">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
          {t('heroSync.synced')}
        </span>
      </div>
      <div class="hero-device hero-device-tablet" aria-hidden="true">
        <Image
          src={deviceTablet}
          alt=""
          widths={[480, 800, 1206]}
          sizes="(max-width: 1023px) 40vw, 27vw"
          loading="eager"
          class="block h-auto w-full"
        />
        <span class="sync-chip">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
          {t('heroSync.synced')}
        </span>
      </div>

      <svg
        class="hero-ring hero-ring-front"
        viewBox="0 0 1000 600"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <!-- Two hot spots on the front pass: past the tablet and under the
               laptop, where the light would catch the rock. -->
          <linearGradient id="ring-b" gradientUnits="userSpaceOnUse" x1="990" y1="0" x2="30" y2="0">
            <stop offset="0" stop-color="oklch(80% 0.16 58)" stop-opacity="0.95" />
            <stop offset="0.14" stop-color="oklch(90% 0.12 68)" />
            <stop offset="0.3" stop-color="oklch(74% 0.17 52)" stop-opacity="0.6" />
            <stop offset="0.52" stop-color="oklch(90% 0.12 68)" />
            <stop offset="0.75" stop-color="oklch(74% 0.17 52)" stop-opacity="0.55" />
            <stop offset="1" stop-color="oklch(76% 0.16 55)" stop-opacity="0.7" />
          </linearGradient>
        </defs>
        <path class="ring-glow" stroke="url(#ring-b)" d={ringB} />
        <path
          class="ring-line ring-b"
          stroke="url(#ring-b)"
          d={ringB}
          style={`--len:${ringLen.b}`}
        />
        <path class="ring-comet ring-b" d={ringB} style={`--len:${ringLen.b}`} />
      </svg>
    </div>

    <div class="hero-chrome hero-bar grid grid-cols-[repeat(3,minmax(0,1fr))_minmax(0,1.15fr)] items-center gap-0 max-[1023px]:grid-cols-3 max-[1023px]:gap-y-5">
      {highlights.map((item) => (
        <div class="hero-highlight flex min-w-0 items-center gap-4 border-r border-white/15 px-8 first:pl-0">
          <svg
            class="h-9 w-9 flex-none text-ink"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            {item.icon === 'devices' ? (
              <>
                <rect x="7" y="4.5" width="15" height="11" rx="1.5" />
                <path d="M12 19.5h5M14.5 15.5v4" />
                <rect x="2" y="8.5" width="6" height="11" rx="1.3" fill="#0d0b18" />
              </>
            ) : item.icon === 'bookmark' ? (
              <path d="M6.5 3.5h11v17L12 16l-5.5 4.5Z" />
            ) : (
              <path d="M13.5 2.5 5 13.5h6l-1 8 8.5-11h-6Z" />
            )}
          </svg>
          <div class="min-w-0">
            <p class="highlight-title text-[1.2rem] leading-tight font-semibold text-ink">
              {item.title}
            </p>
            <p class="highlight-copy mt-1 text-[0.95rem] leading-snug text-ink-soft">{item.copy}</p>
          </div>
        </div>
      ))}

      <!-- Placeholder: there is no video yet, so this card is not interactive. -->
      <div class="hero-video ml-8 flex items-center gap-4 rounded-[18px] border border-white/12 bg-white/[0.06] p-2.5 pr-4 backdrop-blur-md max-[1023px]:ml-0">
        <div
          class="placeholder-surface aspect-[3/2] w-24 flex-none rounded-xl"
          aria-hidden="true"
        ></div>
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-ink">{t('heroBar.videoTitle')}</p>
          <p class="text-[13px] text-ink-soft">{t('heroBar.videoMeta')}</p>
        </div>
        <span
          class="grid h-11 w-11 flex-none place-items-center rounded-full bg-white/85 text-[#0d0b18]"
          aria-hidden="true"
        >
          <svg class="ml-0.5 h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M7 4.5v15l12-7.5Z" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Pointer parallax: a progressive enhancement, like the header's scroll
  // script. It only writes --px/--py (-1…1, eased toward the cursor) on the
  // hero; CSS turns them into a depth-scaled `translate` per layer. Mouse and
  // trackpad only (touch has no hover to follow), and never under reduced
  // motion. The rAF loop stops itself once the layers have caught up.
  (function () {
    var hero = document.querySelector('.hero');
    if (!hero) return;
    var allowed = window.matchMedia(
      '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
    );
    var tx = 0;
    var ty = 0;
    var x = 0;
    var y = 0;
    var raf = 0;
    function frame() {
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      hero.style.setProperty('--px', x.toFixed(4));
      hero.style.setProperty('--py', y.toFixed(4));
      raf = Math.abs(tx - x) > 0.001 || Math.abs(ty - y) > 0.001 ? requestAnimationFrame(frame) : 0;
    }
    function follow(nx, ny) {
      tx = nx;
      ty = ny;
      if (!raf) raf = requestAnimationFrame(frame);
    }
    hero.addEventListener('pointermove', function (event) {
      if (!allowed.matches || event.pointerType === 'touch') return;
      var box = hero.getBoundingClientRect();
      follow(
        ((event.clientX - box.left) / box.width) * 2 - 1,
        ((event.clientY - box.top) / box.height) * 2 - 1,
      );
    });
    hero.addEventListener('pointerleave', function () {
      follow(0, 0);
    });
  })();
</script>

<style>
  /* Desktop: a framed card floating in the sky. The 100vmax spread shadow dims
     the sky outside the card without a second copy of the image. */
  .hero {
    padding: 12px;
  }
  /* The bottom of the sky fades into the steps section's night colour, so
     the hero flows into it instead of ending on an edge. */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 160px;
    background: linear-gradient(to bottom, transparent, #0d0b18);
    pointer-events: none;
  }
  .hero-card {
    height: clamp(680px, calc(100svh - 24px), 980px);
    padding-top: 108px; /* the fixed header overlays this band */
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 28px;
    background: linear-gradient(
      to bottom,
      oklch(12% 0.03 275 / 0.35),
      transparent 30%,
      transparent 62%,
      oklch(10% 0.02 275 / 0.7)
    );
    box-shadow:
      0 0 0 100vmax oklch(12% 0.03 275 / 0.42),
      0 40px 90px -40px oklch(0% 0 0 / 0.8);
  }

  /* The stage is a size container so the wordmark and the devices scale with
     the space they actually get, and the wordmark's intro can be expressed as
     "from the stage's centre" in cqh. */
  .hero-stage {
    container-type: size;
  }
  /* Warm backlight from the sunset behind the devices: it lifts them off the
     sky and ties the screens' edge light to a visible source. */
  .hero-stage::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 4cqh;
    width: 90cqw;
    height: 70cqh;
    translate: -50% 0;
    background: radial-gradient(
      closest-side,
      oklch(72% 0.17 50 / 0.38),
      oklch(65% 0.16 40 / 0.14) 55%,
      transparent
    );
    pointer-events: none;
  }

  .hero-word {
    --word-size: min(21.5cqw, 39cqh);
    --word-top: -1cqh;
    /* Intro only: how far the centred word sits below its resting spot, and how
       much larger it is there (see hero-word-in in global.css). */
    --word-rise: calc(50cqh - var(--word-top) - 0.4 * var(--word-size));
    --word-big: 1.22;
    position: absolute;
    top: var(--word-top);
    left: 50%;
    z-index: 0;
    margin: 0;
    translate: calc(-50% + var(--px) * -10px) calc(var(--py) * -6px);
    font-size: var(--word-size);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(
      100deg,
      oklch(97% 0.01 80) 0%,
      oklch(86% 0.02 60) 42%,
      oklch(80% 0.12 55) 70%,
      oklch(72% 0.19 45) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0.55;
    user-select: none;
  }

  .hero-device {
    position: absolute;
    z-index: 1;
    filter: drop-shadow(0 14px 18px oklch(0% 0 0 / 0.55));
  }
  /* Ground shadow under the whole group: the rock darkens where the devices
     stand, which is what reads as weight. */
  .hero-stage::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -7cqh;
    width: 86cqw;
    height: 18cqh;
    translate: -50% 0;
    background: radial-gradient(
      closest-side,
      oklch(4% 0.01 270 / 0.8),
      oklch(4% 0.01 270 / 0.45) 50%,
      transparent
    );
    filter: blur(8px);
    pointer-events: none;
  }
  /* Contact shadow: a tight dark pool where the device meets the rock, plus a
     wider soft one, so it rests on the ground instead of floating. */
  .hero-device::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 4%;
    right: 4%;
    bottom: -5%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      oklch(0% 0 0 / 0.85),
      oklch(0% 0 0 / 0.45) 55%,
      transparent
    );
    filter: blur(5px);
  }
  .hero-device-phone::after {
    left: -8%;
    right: -8%;
    bottom: -2.5%;
    height: 5%;
  }
  /* Float rhythm per device (see hero-float in global.css): different
     periods and phases so the three never bob in lockstep. */
  .hero-device-laptop {
    --float-y: -7px;
    --float-r: 0deg;
    --float-dur: 6.4s;
    --float-phase: 0s;
    left: 51.5%;
    bottom: -1cqh;
    width: min(51cqw, 106cqh);
    translate: calc(-50% + var(--px) * -18px) calc(var(--py) * -10px);
  }
  .hero-device-phone {
    --float-y: -11px;
    --float-r: -1.2deg;
    --float-dur: 5.2s;
    --float-phase: 0.6s;
    left: 18cqw;
    bottom: -3cqh;
    width: min(14.5cqw, 34cqh);
    translate: calc(var(--px) * -30px) calc(var(--py) * -16px);
  }
  .hero-device-tablet {
    --float-y: -9px;
    --float-r: 1deg;
    --float-dur: 5.8s;
    --float-phase: 1.2s;
    /* Behind the laptop where they overlap; still above the back of the ring
       (z-index 0 too, but later in the DOM). */
    z-index: 0;
    right: 9.5cqw;
    bottom: 0;
    width: min(31.5cqw, 69cqh);
    translate: calc(var(--px) * -26px) calc(var(--py) * -14px);
  }

  /* Floating books. --depth (0 far … 1 near) drives the pointer parallax; the
     far ones are also smaller, softer and dimmer, like the sky's haze. The
     drift (book-drift in global.css) moves `transform`, the tilt is `rotate`
     and the parallax is `translate`, so the three never fight. */
  .hero-book {
    --depth: 0.5;
    --tilt: 0deg;
    --drift-y: -14px;
    --drift-r: 3deg;
    --drift-dur: 11s;
    --drift-phase: 0s;
    position: absolute;
    /* Above both halves of the ring (the front one is z-index 2). */
    z-index: 3;
    pointer-events: none;
    rotate: var(--tilt);
    translate: calc(var(--px) * var(--depth) * -26px) calc(var(--py) * var(--depth) * -14px);
    filter: drop-shadow(0 18px 22px oklch(8% 0.03 280 / 0.45));
  }
  .hero-book :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-book-1 {
    --depth: 0.7;
    --tilt: -10deg;
    left: 5cqw;
    top: 22cqh;
    width: 9cqw;
  }
  .hero-book-2 {
    --depth: 0.6;
    --tilt: 12deg;
    --drift-dur: 13s;
    --drift-phase: -4s;
    --drift-r: -3deg;
    right: 5cqw;
    top: 8cqh;
    width: 8.1cqw;
  }
  .hero-book-3 {
    --depth: 0.9;
    --tilt: -6deg;
    --drift-dur: 12s;
    --drift-phase: -7s;
    right: 0.5cqw;
    top: 62cqh;
    width: 9cqw;
  }
  /* The far left book stays under the ring: the loop passes in front of it. */
  .hero-book-4 {
    z-index: 0;
    --depth: 0.35;
    --tilt: 8deg;
    --drift-dur: 14s;
    --drift-phase: -2s;
    left: 1cqw;
    top: 66cqh;
    width: 8.1cqw;
    opacity: 0.95;
    filter: blur(0.6px) drop-shadow(0 12px 16px oklch(8% 0.03 280 / 0.35));
  }
  .hero-book-5 {
    --depth: 0.2;
    --tilt: 16deg;
    --drift-dur: 15s;
    --drift-phase: -9s;
    --drift-y: -8px;
