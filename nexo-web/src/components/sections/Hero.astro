---
import { Image } from 'astro:assets';
import DownloadButton from '@/components/ui/DownloadButton.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import PlatformIcon from '@/components/ui/PlatformIcon.astro';
import heroMockup from '@/assets/hero-mockup.png';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const platforms = [
  { name: 'android' as const, label: t('hero.platformAndroid') },
  { name: 'windows' as const, label: t('hero.platformWindows') },
  { name: 'macos' as const, label: t('hero.platformMacOS') },
  { name: 'linux' as const, label: t('hero.platformLinux') },
];
---

<!-- ══════════════ HERO ══════════════ -->
<section class="hero-section" id="top">
  <div class="shell hero-grid">
    <div class="min-w-0 rise rise-1">
      <Eyebrow>{t('hero.eyebrow')}</Eyebrow>

      <h1 class="hero-heading">{t('hero.heading')}</h1>

      <p class="mt-6 max-w-[43ch] text-[1.05rem] leading-[1.8] text-ink-soft text-pretty">
        {t('hero.lead')}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3.5 max-[640px]:gap-3">
        <DownloadButton />
        <Button variant="ghost" size="lg" href="#como-funciona">
          {t('header.navHow')}
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </Button>
      </div>

      <ul class="hero-platforms" id="dispositivos">
        {platforms.map((platform) => (
          <li class="inline-flex">
            <a href="#descargar" class="group inline-flex min-h-11 items-center gap-2">
              <PlatformIcon name={platform.name} />
              <span class="text-[13px] font-medium text-ink-soft transition-[color] duration-[180ms] ease-[ease] group-hover:text-ink">
                {platform.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-visual rise rise-2">
      <Image
        src={heroMockup}
        alt={t('hero.mockupAlt')}
        widths={[480, 720, 1080, 1600]}
        sizes="(max-width: 900px) 92vw, 660px"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>
