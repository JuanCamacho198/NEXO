---
import Button from "../ui/Button.astro";
import { defaultLang, useTranslations, type Lang } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---
<!-- ══════════════ CTA BAND ══════════════ -->
<section id="descargar" class="py-28 text-center max-[640px]:py-18">
  <div class="shell max-w-[46rem]">
    <h2 class="mx-auto max-w-[16ch] max-[640px]:text-[2.25rem] min-[640px]:text-[3.75rem]">{t("cta.heading")}</h2>
    <p class="mx-auto mt-5 mb-[34px] max-w-[46ch] text-[1.05rem] leading-[1.75] text-ink-soft text-pretty">{t("cta.lead")}</p>
    <Button
      variant="primary"
      size="lg"
      href="https://github.com/JuanCamacho198/NEXTPAGE/releases"
      icon="download"
    >{t("cta.download")}</Button>
  </div>
</section>
