---
import { Image } from 'astro:assets';
import { storeCovers } from '@/data/landingDemo';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const covers = storeCovers();
// Two shelves drifting in opposite directions; each row is doubled so its
// loop is seamless (the copy is hidden from assistive tech).
const rows = [covers.slice(0, 5), covers.slice(5)];

const days = t('habit.weekDays').split(',');
// Mon–Fri read, today (Saturday) still open. Illustrative, like every number here.
const read = [true, true, true, true, true, false, false];
const minutes = [18, 32, 24, 41, 15, 36, 20];
const peak = Math.max(...minutes);
const goals = [10, 15, 20, 30];
// The daily goal the goal tile shows (12 of 15 min), drawn across the chart.
const dailyGoal = 15;
---

<!-- ══════════════ HABIT ══════════════ -->
<!-- The app's store, streak, daily goal and statistics as one bento grid, so
     four features cost the page a single screen. The figures are illustrative.
     The goal ring and the bars fill as the grid scrolls into view where
     scroll-driven animations exist; elsewhere they simply show filled. -->
<section id="habito" class="habit relative text-ink" data-theme="dark">
  <div class="night-sky" aria-hidden="true"></div>
  <div class="shell relative">
    <div class="habit-head">
      <p class="habit-eyebrow eyebrow-rule">{t('habit.eyebrow')}</p>
      <h2 class="habit-title title-split">
        {t('habit.heading')}{' '}
        <span class="title-accent">
          {t('habit.headingAccent')}
          <svg
            class="title-swoosh"
            viewBox="0 0 300 24"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M4 18C70 7 170 3 296 9" />
          </svg>
        </span>
      </h2>
      <p class="habit-lead">{t('habit.lead')}</p>
    </div>

    <div class="bento">
      <!-- Store -->
      <article class="tile tile-store">
        <div class="tile-text">
          <p class="tile-kicker">
            {t('habit.storeKicker')}
            <span class="store-free">{t('habit.storeFree')}</span>
          </p>
          <h3 class="tile-title">{t('habit.storeTitle')}</h3>
          <p class="tile-copy">{t('habit.storeCopy')}</p>
          <div class="store-sources">
            <span>{t('habit.sourceGutenberg')}</span>
            <span>{t('habit.sourceStandard')}</span>
          </div>
        </div>
        <div class="shelves" aria-hidden="true">
          {rows.map((row, r) => (
            <div class={`shelf shelf-${r + 1}`}>
              <div class="shelf-track">
                {[...row, ...row].map((book) => (
                  <Image
                    src={book.image}
                    alt=""
                    widths={[112, 224]}
                    sizes="112px"
                    quality={78}
                    loading="lazy"
                    decoding="async"
                    class="cover"
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      </article>

      <!-- Streak -->
      <article class="tile tile-streak">
        <p class="tile-kicker">{t('habit.streakKicker')}</p>
        <div class="streak-count">
          <!-- A flame in a warm glow: an outer flame and a lighter core that
               flicker out of step, with embers drifting up. -->
          <span class="flame-wrap" aria-hidden="true">
            <svg class="streak-flame" viewBox="0 0 24 24">
              <defs>
                <linearGradient id="flame" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffd27a" />
                  <stop offset="1" stop-color="#f06a2c" />
                </linearGradient>
                <linearGradient id="flame-core" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffe9a8" />
                  <stop offset="1" stop-color="#ffb04a" />
                </linearGradient>
              </defs>
              <path
                d="M12 2.5c.6 3.2 3.7 4.9 4.9 8 1.6 4.2-1.2 9-4.9 9s-6.4-3.2-5.5-6.9c.4-1.7 1.4-2.9 2.4-3.7-.1 1.5.4 2.8 1.5 3.4C10.6 9.4 10.5 5.6 12 2.5Z"
                fill="url(#flame)"
              />
              <path
                class="flame-core"
                d="M12 10.2c.5 2 2.5 3.1 2.7 5.4.2 2.3-1.2 3.9-2.7 3.9s-2.9-1.4-2.7-3.5c.2-1.4 1-2.1 1.6-2.7 0 .9.4 1.5 1 1.8-.3-1.6-.3-3.2.1-4.9Z"
                fill="url(#flame-core)"
              />
            </svg>
            <span class="ember ember-1"></span>
            <span class="ember ember-2"></span>
            <span class="ember ember-3"></span>
          </span>
          <strong>{t('habit.streakDays')}</strong>
        </div>
        <p class="tile-copy">{t('habit.streakCopy')}</p>
        <ol class="week" aria-label={t('habit.weekAria')}>
          {days.map((day, i) => (
            <li class:list={['day', read[i] && 'is-read', i === 5 && 'is-today']}>
              <span class="day-dot" aria-hidden="true">
                {read[i] ? (
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M12 2.5c.6 3.2 3.7 4.9 4.9 8 1.6 4.2-1.2 9-4.9 9s-6.4-3.2-5.5-6.9c.4-1.7 1.4-2.9 2.4-3.7-.1 1.5.4 2.8 1.5 3.4C10.6 9.4 10.5 5.6 12 2.5Z"
                      fill="currentColor"
                    />
                  </svg>
                ) : null}
              </span>
              <span class="day-name">{day}</span>
            </li>
          ))}
        </ol>
        <p class="streak-best">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 4h10v4a5 5 0 0 1-10 0Z" />
            <path d="M7 6H4.5a2.5 2.5 0 0 0 2.6 3.2M17 6h2.5a2.5 2.5 0 0 1-2.6 3.2M12 13v4M8.5 20h7l-1-3h-5Z" />
          </svg>
          {t('habit.streakBest')}
          <strong>{t('habit.streakBestDays')}</strong>
        </p>
      </article>

      <!-- Daily goal -->
      <article class="tile tile-goal">
        <p class="tile-kicker">{t('habit.goalKicker')}</p>
        <div class="goal-body">
          <div class="goal-ring" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <circle class="ring-track" cx="60" cy="60" r="50" />
              <circle class="ring-value" cx="60" cy="60" r="50" pathLength="100" />
            </svg>
            <span class="goal-number">
              <strong>12</strong>
              <small>{t('habit.goalOf')}</small>
            </span>
          </div>
          <div>
            <h3 class="tile-title">{t('habit.goalTitle')}</h3>
            <p class="tile-copy">{t('habit.goalCopy')}</p>
          </div>
        </div>
        <ul class="goal-presets" aria-label={t('habit.goalPresetsAria')}>
          {goals.map((goal) => (
            <li class:list={[goal === 15 && 'is-on']}>
              {goal === 30 ? '30+' : goal}
              <small>{t('habit.minutesShort')}</small>
            </li>
          ))}
        </ul>
      </article>

      <!-- Statistics -->
      <article class="tile tile-stats">
        <div class="stats-head">
          <div>
            <p class="tile-kicker">{t('habit.statsKicker')}</p>
            <h3 class="tile-title">{t('habit.statsTitle')}</h3>
          </div>
          <dl class="stats-figures">
            <div class="is-lead">
              <dt>{t('habit.statsMinutes')}</dt>
              <dd>186</dd>
            </div>
            <div>
              <dt>{t('habit.statsSessions')}</dt>
              <dd>9</dd>
            </div>
            <div>
              <dt>{t('habit.statsBooks')}</dt>
              <dd>2</dd>
            </div>
          </dl>
        </div>
        <div class="bars-wrap" style={`--goal: ${dailyGoal / peak}`}>
          <ol class="bars" aria-label={t('habit.statsAria')}>
            {minutes.map((value, i) => (
              <li
                class:list={['bar', i === 3 && 'is-peak']}
                style={`--h: ${(value / peak) * 100}%`}
              >
                <span class="bar-value">
                  {value}
                  {i === 3 && <small> {t('habit.minutesShort')}</small>}
                </span>
                <span class="bar-fill" />
                <span class="bar-day">{days[i]}</span>
              </li>
            ))}
          </ol>
          <!-- Daily goal: a dashed threshold across the chart. -->
          <span class="goal-line" aria-hidden="true">
            <span>
              {t('habit.goalKicker')} · {dailyGoal} {t('habit.minutesShort')}
            </span>
          </span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .habit {
    background: #0d0b18;
    padding: 110px 0 120px;
    overflow: clip;
  }
  .habit-head {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .habit-eyebrow {
    justify-content: center;
    color: oklch(76% 0.16 55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .habit-title {
    margin-top: 14px;
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
  }
  .habit-lead {
    margin-top: 16px;
    color: var(--color-ink-soft);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 56px;
  }
  .tile {
    position: relative;
    min-width: 0;
    padding: 28px;
    border: 1px solid oklch(100% 0 0 / 0.09);
    border-radius: 26px;
    background: linear-gradient(180deg, oklch(100% 0 0 / 0.05), oklch(100% 0 0 / 0.015));
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.06);
    /* clip, not hidden: hidden makes the tile a scroll container, so the bars'
       and ring's view() timelines tracked the tile instead of the page and
       froze part-way (the bars stopped at 50–80% of their height). */
    overflow: clip;
  }
  .tile-store {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: center;
    background:
      radial-gradient(70% 90% at 100% 50%, oklch(72% 0.18 50 / 0.12), transparent 70%),
      linear-gradient(180deg, oklch(100% 0 0 / 0.05), oklch(100% 0 0 / 0.015));
  }
  .tile-stats {
    grid-column: span 2;
    background:
      radial-gradient(60% 80% at 55% 100%, oklch(72% 0.18 50 / 0.1), transparent 70%),
      linear-gradient(180deg, oklch(100% 0 0 / 0.05), oklch(100% 0 0 / 0.015));
  }
  .tile-kicker {
    color: oklch(80% 0.14 58);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tile-title {
    margin-top: 8px;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .tile-copy {
    margin-top: 8px;
    color: var(--color-ink-soft);
    font-size: 0.97rem;
    line-height: 1.55;
  }

  /* ── store ── */
  .store-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .store-sources span {
    padding: 6px 12px;
    border: 1px solid oklch(100% 0 0 / 0.12);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .shelves {
    display: grid;
    gap: 14px;
    margin-right: -28px;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }
  .shelf {
    overflow: hidden;
  }
  .shelf-track {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: shelf-drift 48s linear infinite;
  }
  .shelf-2 .shelf-track {
    animation-direction: reverse;
    animation-duration: 56s;
  }
  .cover {
    display: block;
    flex: none;
    width: 112px;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 6px 10px 10px 6px;
    /* A spine shadow on the left edge and a soft drop, so a flat image reads
       as a book on a shelf. */
    box-shadow:
      inset 4px 0 6px -2px oklch(0% 0 0 / 0.35),
      0 14px 26px -12px oklch(0% 0 0 / 0.85);
  }
  .tile-store:hover .shelf-track {
    animation-play-state: paused;
  }
  .store-free {
    margin-left: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: oklch(72% 0.17 155 / 0.18);
    color: oklch(84% 0.15 155);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  /* ── streak ── */
  .streak-count {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .flame-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(72% 0.18 50 / 0.35), transparent);
    animation: flame-glow 2.8s ease-in-out infinite;
  }
  .streak-flame {
    width: 44px;
    height: 44px;
    overflow: visible;
    filter: drop-shadow(0 0 14px oklch(72% 0.18 50 / 0.6));
    transform-origin: 50% 90%;
    animation: flame-flicker 2.4s ease-in-out infinite;
  }
  .flame-core {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    opacity: 0.9;
    animation: core-flicker 1.3s ease-in-out infinite alternate;
  }
  .ember {
    position: absolute;
    left: 50%;
    bottom: 40%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: oklch(86% 0.15 70);
    box-shadow: 0 0 6px oklch(76% 0.18 55);
    opacity: 0;
    animation: ember-rise 2.6s ease-out infinite;
  }
  .ember-2 {
    --ember-x: -10px;
    width: 3px;
    height: 3px;
    animation-delay: -0.9s;
    animation-duration: 2.2s;
  }
  .ember-3 {
    --ember-x: 9px;
    animation-delay: -1.7s;
    animation-duration: 3s;
  }
  .streak-count strong {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(100deg, oklch(98% 0.01 80), oklch(86% 0.1 64));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* The week: a track runs through the day centres and fills orange up to
     today, so the streak reads as one unbroken line. No gap between columns,
     so each centre sits at exactly (2i + 1) / 14 of the row. */
  .week {
    --dot: 34px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-top: 20px;
  }
  .week::before,
  .week::after {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2 - 1.5px);
    left: calc(100% / 14);
    height: 3px;
    border-radius: 3px;
  }
  .week::before {
    right: calc(100% / 14);
    background: oklch(100% 0 0 / 0.08);
  }
  .week::after {
    width: calc(100% * 10 / 14);
    background: linear-gradient(90deg, oklch(72% 0.18 50 / 0.5), oklch(78% 0.17 58));
    box-shadow: 0 0 10px oklch(72% 0.18 50 / 0.6);
    transform-origin: left;
  }
  .day {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .day-dot {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--dot);
    aspect-ratio: 1;
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 12px;
    background: oklch(18% 0.03 270);
  }
  .day-dot svg {
    width: 55%;
    height: 55%;
  }
  .is-read .day-dot {
    border-color: oklch(72% 0.18 50 / 0.55);
    background:
      linear-gradient(180deg, oklch(72% 0.18 50 / 0.3), oklch(72% 0.18 50 / 0.12)),
      oklch(18% 0.03 270);
    color: oklch(82% 0.17 60);
    box-shadow: 0 0 14px -4px oklch(72% 0.18 50 / 0.7);
  }
  .is-today .day-dot {
    border: 1.5px dashed oklch(80% 0.14 58 / 0.8);
  }
  /* Today is still open: a slow pulse asks for the next session. */
  .is-today .day-dot::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 15px;
    border: 1.5px solid oklch(76% 0.17 55 / 0.6);
    animation: today-pulse 2.2s ease-out infinite;
  }
  .is-today .day-name {
    color: oklch(82% 0.14 60);
  }
  .streak-best {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid oklch(100% 0 0 / 0.08);
    color: var(--color-ink-soft);
    font-size: 13.5px;
  }
  .streak-best svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: oklch(80% 0.15 60);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .streak-best strong {
    margin-left: auto;
    color: var(--color-ink);
    font-weight: 700;
  }
  .day-name {
    color: var(--color-muted-foreground);
    font-size: 11px;
    font-weight: 600;
  }

  /* ── goal ── */
  .goal-body {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 12px;
  }
  .goal-ring {
    position: relative;
    flex: none;
    width: 112px;
    height: 112px;
  }
  .goal-ring svg {
    width: 100%;
    height: 100%;
    rotate: -90deg;
  }
  .ring-track,
  .ring-value {
    fill: none;
    stroke-width: 10;
  }
  .ring-track {
    stroke: oklch(100% 0 0 / 0.08);
  }
  .ring-value {
    stroke: oklch(74% 0.18 52);
    stroke-linecap: round;
    stroke-dasharray: 80 100;
    filter: drop-shadow(0 0 6px oklch(72% 0.18 50 / 0.6));
  }
  .goal-number {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
  }
  .goal-number strong {
    font-size: 1.9rem;
    line-height: 1;
  }
  .goal-number small {
    margin-top: 2px;
    color: var(--color-ink-soft);
    font-size: 11.5px;
  }
  .goal-presets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 20px;
  }
  .goal-presets li {
    padding: 9px 4px;
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 12px;
    text-align: center;
    font-weight: 700;
  }
  .goal-presets small {
    margin-left: 2px;
    color: var(--color-ink-soft);
    font-size: 11px;
    font-weight: 500;
  }
  .goal-presets .is-on {
    border-color: oklch(72% 0.18 50 / 0.7);
    background: oklch(72% 0.18 50 / 0.14);
    color: oklch(86% 0.13 62);
  }

  /* ── stats ── */
  .stats-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px 28px;
  }
  /* Figures separated by thin rules; the week's minutes lead in orange. */
  .stats-figures {
    display: flex;
    gap: 0;
  }
  .stats-figures > div {
    padding: 0 24px;
    border-left: 1px solid oklch(100% 0 0 / 0.1);
  }
  .stats-figures > div:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .stats-figures > div:last-child {
    padding-right: 0;
  }
  .stats-figures dt {
    color: var(--color-ink-soft);
    font-size: 12.5px;
  }
  .stats-figures dd {
    margin: 2px 0 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .stats-figures .is-lead dd {
    background: linear-gradient(100deg, oklch(86% 0.13 68), oklch(72% 0.19 46));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Chart. Fixed label rows, so the bar area's height is known and the goal
     line can sit at exactly --goal of it. */
  .bars-wrap {
    --bars-h: 180px;
    --value-row: 26px;
    --day-row: 16px;
    --row-gap: 6px;
    position: relative;
    margin-top: 24px;
  }
  .bars {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 14px;
    height: var(--bars-h);
  }
  .bar {
    display: grid;
    grid-template-rows: var(--value-row) 1fr var(--day-row);
    justify-items: center;
    gap: var(--row-gap);
    min-height: 0;
  }
  /* A faint full-height capsule behind each bar: the scale it fills. */
  .bar::before {
    content: '';
    grid-row: 2;
    grid-column: 1;
    width: 100%;
    max-width: 46px;
    height: 100%;
    border-radius: 12px;
    background: oklch(100% 0 0 / 0.035);
  }
  .bar-value {
    grid-row: 1;
    align-self: end;
    color: var(--color-ink-soft);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }
  .bar-fill {
    grid-row: 2;
    grid-column: 1;
    align-self: end;
    width: 100%;
    max-width: 46px;
    height: var(--h);
    border-radius: 12px 12px 6px 6px;
    background: linear-gradient(180deg, oklch(82% 0.07 70 / 0.75), oklch(60% 0.09 50 / 0.18));
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.25);
    transform-origin: bottom;
  }
