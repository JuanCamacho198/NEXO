---
import { dictionaryDemo } from '@/data/landingDemo';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const demo = dictionaryDemo(lang);
const first = demo.words[0];
const byId = new Map(demo.words.map((word) => [word.id, word]));

const features = [
  { title: t('dict.f1Title'), copy: t('dict.f1Copy'), icon: 'book' },
  { title: t('dict.f2Title'), copy: t('dict.f2Copy'), icon: 'translate' },
  { title: t('dict.f3Title'), copy: t('dict.f3Copy'), icon: 'bookmark' },
] as const;
---

<!-- ══════════════ DICTIONARY ══════════════ -->
<!-- A small working reader. Tapping a highlighted word opens the app's lookup
     card (definition or translation) next to it; "Save" drops the word into
     the dictionary list; "Translate paragraph" reveals the whole passage in the
     visitor's language. Without JavaScript the first word's card is simply
     shown under the page, so the section still says everything it needs to. -->
<section id="funciones" class="dict relative text-ink" data-theme="dark">
  <div class="night-sky" aria-hidden="true"></div>
  <div class="shell dict-grid relative">
    <div class="dict-copy">
      <p class="dict-eyebrow eyebrow-rule is-start">{t('dict.eyebrow')}</p>
      <h2 class="dict-title title-split">
        {t('dict.heading')}{' '}
        <span class="title-accent">
          {t('dict.headingAccent')}
          <svg
            class="title-swoosh"
            viewBox="0 0 300 24"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M4 18C70 7 170 3 296 9" />
          </svg>
        </span>
      </h2>
      <p class="dict-lead">{t('dict.lead')}</p>
      <ul class="dict-features">
        {features.map((feature) => (
          <li>
            <span class="dict-feature-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {feature.icon === 'book' ? (
                  <>
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5Z" />
                    <path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5" />
                  </>
                ) : feature.icon === 'translate' ? (
                  <>
                    <path d="M4 5h9M8.5 3v2M6 5c.5 3 2.5 5.5 5 7M11 5c-.6 3.4-3 6.4-6 8" />
                    <path d="m13 21 4-9 4 9M14.5 18h5" />
                  </>
                ) : (
                  <path d="M6.5 3.5h11v17L12 16l-5.5 4.5Z" />
                )}
              </svg>
            </span>
            <span>
              <strong>{feature.title}</strong>
              <small>{feature.copy}</small>
            </span>
          </li>
        ))}
      </ul>
      <p class="dict-note">{t('dict.note')}</p>
    </div>

    <div class="dict-demo" data-dict-demo>
      <!-- The reader sits in an iPhone: bezel, Dynamic Island, status bar,
           side buttons and home indicator are all decorative. -->
      <div class="dict-phone">
        <div class="dict-reader">
          <div class="phone-status" aria-hidden="true">
            <span class="phone-time">9:41</span>
            <span class="phone-island"></span>
            <span class="phone-icons">
              <svg viewBox="0 0 18 12" fill="currentColor">
                <rect x="0" y="8" width="3" height="4" rx="1" />
                <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
                <rect x="10" y="3" width="3" height="9" rx="1" />
                <rect x="15" y="0" width="3" height="12" rx="1" />
              </svg>
              <svg viewBox="0 0 16 12" fill="currentColor">
                <path d="M8 2.2c2.4 0 4.6.9 6.3 2.5l1.2-1.3A10.7 10.7 0 0 0 8 .4 10.7 10.7 0 0 0 .5 3.4l1.2 1.3A9 9 0 0 1 8 2.2Zm0 3.6c1.4 0 2.7.5 3.7 1.4l1.2-1.3A7.2 7.2 0 0 0 8 4 7.2 7.2 0 0 0 3.1 5.9l1.2 1.3c1-.9 2.3-1.4 3.7-1.4Zm0 3.5c-.6 0-1.2.2-1.6.6L8 11.6l1.6-1.7c-.4-.4-1-.6-1.6-.6Z" />
              </svg>
              <svg viewBox="0 0 27 12" fill="none">
                <rect
                  x="0.5"
                  y="0.5"
                  width="23"
                  height="11"
                  rx="3.5"
                  stroke="currentColor"
                  opacity="0.4"
                />
                <rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor" />
                <path
                  d="M25 4v4c.8-.3 1.3-1.1 1.3-2s-.5-1.7-1.3-2Z"
                  fill="currentColor"
                  opacity="0.4"
                />
              </svg>
            </span>
          </div>
          <div class="dict-reader-top">
            <span>{demo.bookTitle}</span>
            <span class="dict-hint">{t('dict.hint')}</span>
          </div>
          <article class="dict-page" lang={demo.bookLang}>
            <p class="dict-chapter">{demo.chapter}</p>
            <p class="dict-text">
              {demo.segments.map((segment) =>
                typeof segment === 'string' ? (
                  segment
                ) : (
                  <button
                    type="button"
                    class="dict-word"
                    data-word={segment.word}
                    aria-pressed={segment.word === first.id ? 'true' : 'false'}
                  >
                    {byId.get(segment.word)?.text}
                  </button>
                ),
              )}
            </p>
            <button
              type="button"
              class="dict-translate"
              data-translate-toggle
              aria-expanded="false"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 5h9M8.5 3v2M6 5c.5 3 2.5 5.5 5 7M11 5c-.6 3.4-3 6.4-6 8" />
                <path d="m13 21 4-9 4 9M14.5 18h5" />
              </svg>
              <span class="label-show">{t('dict.translateParagraph')}</span>
              <span class="label-hide">{t('dict.hideTranslation')}</span>
            </button>
            <p class="dict-paragraph" lang={lang} hidden data-translation>
              {demo.paragraphTranslation}
            </p>
          </article>
          <div class="phone-progress" aria-hidden="true">
            <span></span>
          </div>
          <!-- The reader's bottom toolbar: type, highlight, bookmark, contents. -->
          <div class="phone-toolbar" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M3 19 8.5 5h1L15 19M5 14.5h8" />
              <path d="M17 19v-6.5a2.5 2.5 0 0 1 5 0V19M17 15.5h5" />
            </svg>
            <svg viewBox="0 0 24 24" class="is-on">
              <path d="m14.5 4.5 5 5L10 19H5v-5Z" />
              <path d="M3 21.5h18" />
            </svg>
            <svg viewBox="0 0 24 24">
              <path d="M6.5 3.5h11v17L12 16l-5.5 4.5Z" />
            </svg>
            <svg viewBox="0 0 24 24">
              <path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01" />
            </svg>
          </div>
          <span class="phone-home" aria-hidden="true"></span>
        </div>
      </div>

      <div class="dict-side">
        <!-- One lookup card per word; the script shows the active one. It
             sits beside the page, never over it, so no word is ever covered. -->
        <div class="dict-cards" aria-live="polite">
          {demo.words.map((word) => (
            <div
              class="dict-card"
              data-card={word.id}
              data-tab="definition"
              hidden={word.id !== first.id}
            >
              <div class="dict-card-head">
                <strong lang={demo.bookLang}>{word.text}</strong>
                <span>{word.partOfSpeech}</span>
              </div>
              <div class="dict-tabs" role="group">
                <button type="button" data-tab-button="definition" aria-pressed="true">
                  {t('dict.tabDefinition')}
                </button>
                <button type="button" data-tab-button="translation" aria-pressed="false">
                  {t('dict.tabTranslation')}
                </button>
              </div>
              <p class="dict-def">{word.definition}</p>
              <p class="dict-tr">{word.translation}</p>
              <button type="button" class="dict-save" data-save={word.id}>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6.5 3.5h11v17L12 16l-5.5 4.5Z" />
                </svg>
                <span class="label-show">{t('dict.save')}</span>
                <span class="label-hide">{t('dict.saved')}</span>
              </button>
            </div>
          ))}
        </div>
        <aside class="dict-saved">
          <div class="dict-saved-head">
            <strong>{t('dict.myDictionary')}</strong>
            <span class="dict-count" data-count>
              0
            </span>
          </div>
          <p class="dict-empty" data-empty>
            {t('dict.empty')}
          </p>
          <ul class="dict-saved-list">
            {demo.words.map((word) => (
              <li data-saved={word.id} hidden>
                <span class="dict-saved-initial" aria-hidden="true">
                  {word.text.charAt(0).toUpperCase()}
                </span>
                <span>
                  <strong lang={demo.bookLang}>{word.text}</strong>
                  <small>{word.translation}</small>
                </span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var demo = document.querySelector('[data-dict-demo]');
    if (!demo) return;
    var words = demo.querySelectorAll('.dict-word');
    var cards = demo.querySelectorAll('.dict-card');
    var count = demo.querySelector('[data-count]');
    var empty = demo.querySelector('[data-empty]');
    var saved = 0;

    function open(id) {
      words.forEach(function (word) {
        word.setAttribute('aria-pressed', word.getAttribute('data-word') === id ? 'true' : 'false');
      });
      cards.forEach(function (card) {
        card.hidden = card.getAttribute('data-card') !== id;
      });
    }
    words.forEach(function (word) {
      word.addEventListener('click', function () {
        open(word.getAttribute('data-word'));
      });
    });
    cards.forEach(function (card) {
      card.querySelectorAll('[data-tab-button]').forEach(function (button) {
        button.addEventListener('click', function () {
          var tab = button.getAttribute('data-tab-button');
          card.setAttribute('data-tab', tab);
          card.querySelectorAll('[data-tab-button]').forEach(function (other) {
            other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
          });
        });
      });
      var save = card.querySelector('[data-save]');
      save.addEventListener('click', function () {
        if (save.hasAttribute('data-done')) return;
        save.setAttribute('data-done', '');
        var item = demo.querySelector('[data-saved="' + save.getAttribute('data-save') + '"]');
        if (item) item.hidden = false;
        saved += 1;
        count.textContent = String(saved);
        count.setAttribute('data-bump', '');
        setTimeout(function () {
          count.removeAttribute('data-bump');
        }, 400);
        empty.hidden = true;
      });
    });
    var toggle = demo.querySelector('[data-translate-toggle]');
    var translation = demo.querySelector('[data-translation]');
    toggle.addEventListener('click', function () {
      var show = translation.hidden;
      translation.hidden = !show;
      toggle.setAttribute('aria-expanded', show ? 'true' : 'false');
    });
  })();
</script>

<style>
  .dict {
    --orange: oklch(72% 0.18 50);
    --cyan: #4fd1f5;
    background: #0d0b18;
    padding: 120px 0;
    overflow: clip;
  }
  .dict-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.5fr;
    gap: 56px;
    align-items: center;
  }
  .dict-eyebrow {
    color: oklch(76% 0.16 55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .dict-title {
    margin-top: 14px;
    font-size: clamp(2.2rem, 4vw, 3.3rem);
  }
  .dict-lead {
    margin-top: 16px;
    max-width: 40ch;
    color: var(--color-ink-soft);
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .dict-features {
    display: grid;
    gap: 18px;
    margin-top: 32px;
  }
  .dict-features li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .dict-feature-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 12px;
    background: oklch(72% 0.18 50 / 0.1);
    color: oklch(80% 0.15 55);
  }
  .dict-feature-icon svg {
    width: 20px;
    height: 20px;
  }
  .dict-features strong {
    display: block;
    font-size: 1rem;
  }
  .dict-features small {
    display: block;
    margin-top: 2px;
    color: var(--color-ink-soft);
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .dict-note {
    margin-top: 26px;
    color: var(--color-muted-foreground);
    font-size: 13px;
  }

  /* ── demo ── */
  .dict-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 18px;
    align-items: center;
  }
  /* iPhone: a titanium frame (the outer ring), a black bezel, the screen
     inside. Phone proportions come from aspect-ratio, which only sets a
     minimum, so opening the paragraph translation grows the phone instead of
     overflowing it. */
  .dict-phone {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-self: center;
    width: min(100%, 350px);
    aspect-ratio: 9 / 18;
    padding: 11px;
    border-radius: 56px;
    background: #050507;
    box-shadow:
      0 0 0 2px oklch(42% 0.015 270),
      0 0 0 3.5px oklch(24% 0.01 270),
      inset 0 0 0 1px oklch(100% 0 0 / 0.06),
      0 50px 90px -30px oklch(0% 0 0 / 0.85),
      0 0 80px -20px oklch(70% 0.17 50 / 0.35);
  }
  /* Side buttons: action + volume on the left, power on the right. */
  .dict-phone::before,
  .dict-phone::after {
    content: '';
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: oklch(36% 0.015 270);
  }
  .dict-phone::before {
    left: -5.5px;
    top: 17%;
    height: 5%;
    box-shadow:
      0 calc(var(--vol-gap, 60px)) 0 oklch(36% 0.015 270),
      0 calc(var(--vol-gap, 60px) * 2.1) 0 oklch(36% 0.015 270);
  }
  .dict-phone::after {
    right: -5.5px;
    top: 25%;
    height: 12%;
  }
  /* flex: 1 rather than height: 100%, and overflow: clip rather than hidden
     (hidden zeroes a flex item's minimum height), so a taller screen (the
     translation open) stretches the phone instead of being cut off in it. */
  .dict-reader {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: clip;
    border-radius: 46px;
    background:
      radial-gradient(120% 50% at 50% 0%, oklch(30% 0.06 50 / 0.35), transparent 60%),
      oklch(15% 0.03 270);
    padding: 0 12px 10px;
  }
  .phone-status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 50px;
    padding: 4px 18px 0 26px;
    font-size: 14px;
    font-weight: 600;
  }
  .phone-island {
    position: absolute;
    left: 50%;
    top: 11px;
    width: 32%;
    height: 30px;
    border-radius: 999px;
    background: #000;
    translate: -50% 0;
  }
  .phone-icons {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .phone-icons svg {
    height: 11px;
    width: auto;
  }
  .dict-reader-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 6px 6px 12px;
    font-size: 14px;
    font-weight: 600;
  }
  .phone-progress {
    margin: auto 10px 0;
    padding-top: 16px;
  }
  .phone-progress span {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, oklch(74% 0.18 52) 12%, oklch(100% 0 0 / 0.12) 12%);
  }
  .phone-toolbar {
    display: flex;
    justify-content: space-around;
    padding: 14px 8px 0;
  }
  .phone-toolbar svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: oklch(100% 0 0 / 0.55);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .phone-toolbar .is-on {
    stroke: oklch(78% 0.16 58);
  }
  .phone-home {
    display: block;
    width: 36%;
    height: 5px;
    margin: 14px auto 0;
    border-radius: 999px;
    background: oklch(100% 0 0 / 0.75);
  }
  .dict-hint {
    color: oklch(80% 0.15 55);
    font-size: 12.5px;
    font-weight: 600;
  }
  .dict-page {
    border-radius: 22px;
    background: #f7f9fc;
    color: #1b2433;
    padding: 26px 22px 22px;
  }
  .dict-chapter {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-align: center;
    text-transform: uppercase;
    color: #64748b;
  }
  .dict-text {
    margin-top: 16px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .dict-word {
    padding: 0 2px;
    border: 0;
    border-radius: 5px;
    background: oklch(85% 0.12 85 / 0.35);
    color: inherit;
    font: inherit;
    cursor: pointer;
    box-shadow: inset 0 -2px 0 oklch(72% 0.16 70);
    transition:
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .dict-word:hover {
    background: oklch(85% 0.12 85 / 0.6);
  }
  .dict-word[aria-pressed='true'] {
    background: #f6d365;
    box-shadow: 0 0 0 2px #f6d365;
  }
  .dict-translate {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 9px 14px;
    border: 1px solid #d6dde8;
    border-radius: 999px;
    background: #fff;
    color: #1b2433;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
  }
  .dict-translate:hover {
    border-color: #94a3b8;
  }
  .dict-translate svg {
    width: 16px;
    height: 16px;
    color: #0e7490;
  }
  .label-hide,
  [aria-expanded='true'] .label-show,
  [data-done] .label-show {
    display: none;
  }
  [aria-expanded='true'] .label-hide,
  [data-done] .label-hide {
    display: inline;
  }
  .dict-paragraph {
    margin-top: 14px;
    padding: 14px 16px;
    border-left: 3px solid var(--cyan);
    border-radius: 0 10px 10px 0;
    background: #eaf7fb;
    color: #334155;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .dict-side {
    display: grid;
    gap: 14px;
  }
  .dict-card {
    padding: 20px 20px 18px;
    border: 1px solid oklch(72% 0.18 50 / 0.4);
    border-radius: 22px;
    background:
      radial-gradient(90% 80% at 0% 0%, oklch(72% 0.18 50 / 0.12), transparent 60%),
      oklch(20% 0.035 265 / 0.9);
    box-shadow: 0 30px 60px -30px oklch(72% 0.18 50 / 0.4);
    color: var(--color-ink);
    animation: card-in 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .dict-card[hidden] {
    display: none;
  }
  .dict-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .dict-card-head strong {
    font-size: 1.25rem;
  }
  .dict-card-head span {
    color: var(--color-ink-soft);
    font-size: 12px;
    text-align: right;
  }
  .dict-tabs {
    display: flex;
    gap: 4px;
    margin-top: 12px;
    padding: 4px;
    border-radius: 12px;
    background: oklch(100% 0 0 / 0.05);
  }
  .dict-tabs button {
    flex: 1;
    padding: 7px 10px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--color-ink-soft);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .dict-tabs button[aria-pressed='true'] {
    background: oklch(100% 0 0 / 0.1);
    color: var(--color-ink);
  }
  .dict-def,
  .dict-tr {
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.55;
  }
  .dict-tr {
    color: var(--cyan);
    font-size: 1.15rem;
    font-weight: 600;
  }
  [data-tab='definition'] .dict-tr,
  [data-tab='translation'] .dict-def {
    display: none;
  }
  .dict-save {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding: 9px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--orange);
    color: #1b0d03;
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .dict-save[data-done] {
    background: oklch(72% 0.17 155 / 0.2);
    color: oklch(82% 0.16 155);
    cursor: default;
  }
  .dict-save svg {
    width: 15px;
    height: 15px;
  }

  /* Saved words: the app's dictionary list, filling as the visitor saves. */
  .dict-saved {
    padding: 18px 16px;
    border: 1px solid oklch(100% 0 0 / 0.09);
    border-radius: 22px;
    background: oklch(100% 0 0 / 0.03);
  }
  .dict-saved-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
  }
  .dict-count {
