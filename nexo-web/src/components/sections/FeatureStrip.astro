---
import { defaultLang, useTranslations, type Lang } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const features = [
  {
    title: t("strip.cloudTitle"),
    copy: t("strip.cloudCopy"),
    icon: "cloud",
  },
  {
    title: t("strip.devicesTitle"),
    copy: t("strip.devicesCopy"),
    icon: "monitor",
  },
  {
    title: t("strip.searchTitle"),
    copy: t("strip.searchCopy"),
    icon: "search",
  },
  {
    title: t("strip.privacyTitle"),
    copy: t("strip.privacyCopy"),
    icon: "shield",
  },
] as const;
---
<!-- ══════════════ FEATURE STRIP ══════════════ -->
<section id="caracteristicas" class="border-t border-border bg-surface-alt py-24 max-[640px]:py-16">
  <div class="shell grid grid-cols-4 gap-12 max-[900px]:grid-cols-2 max-[900px]:gap-10 max-[640px]:grid-cols-1 max-[640px]:gap-8">
    {features.map((feature) => (
      <div class="min-w-0">
        <svg class="mb-4 block h-5 w-5 text-ink" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          {feature.icon === "cloud" ? (
            <path d="M7 18h9.5a3.5 3.5 0 0 0 .4-6.98A5.5 5.5 0 0 0 6.2 10.5 3.75 3.75 0 0 0 7 18Z" />
          ) : feature.icon === "monitor" ? (
            <>
              <rect x="2.5" y="4" width="19" height="13" rx="2" />
              <path d="M8.5 21h7M12 17v4" />
            </>
          ) : feature.icon === "search" ? (
            <>
              <circle cx="11" cy="11" r="7" />
              <path d="m20.5 20.5-4.2-4.2" />
            </>
          ) : (
            <>
              <path d="M12 3l7.5 3v5.5c0 4.6-3.1 7.9-7.5 9.5-4.4-1.6-7.5-4.9-7.5-9.5V6Z" />
              <path d="m9.2 12 2 2 3.6-3.8" />
            </>
          )}
        </svg>
        <h3 class="mb-2">{feature.title}</h3>
        <p class="max-w-[26ch] text-[0.95rem] leading-[1.6] text-ink-soft">{feature.copy}</p>
      </div>
    ))}
  </div>
</section>
