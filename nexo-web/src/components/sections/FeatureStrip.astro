---
const features = [
  {
    title: "Sincronización en la nube",
    copy: "Tus libros, notas y resaltados siempre actualizados.",
    icon: "cloud",
  },
  {
    title: "Todos tus dispositivos",
    copy: "Android, Windows, macOS, Linux y tablet.",
    icon: "monitor",
  },
  {
    title: "Organiza y encuentra",
    copy: "Filtra tus libros, notas y resaltados fácilmente.",
    icon: "search",
  },
  {
    title: "Privacidad primero",
    copy: "Tus datos están seguros y solo tú tienes acceso.",
    icon: "shield",
  },
] as const;
---
<!-- ══════════════ FEATURE STRIP ══════════════ -->
<section id="caracteristicas" class="section-alt feature-strip">
  <div class="container">
    {features.map((feature) => (
      <div class="strip-item">
        <svg class="strip-ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          {feature.icon === "cloud" ? (
            <path d="M7 18h9.5a3.5 3.5 0 0 0 .4-6.98A5.5 5.5 0 0 0 6.2 10.5 3.75 3.75 0 0 0 7 18Z" />
          ) : feature.icon === "monitor" ? (
            <>
              <rect x="2.5" y="4" width="19" height="13" rx="2" />
              <path d="M8.5 21h7M12 17v4" />
            </>
          ) : feature.icon === "search" ? (
            <>
              <circle cx="11" cy="11" r="7" />
              <path d="m20.5 20.5-4.2-4.2" />
            </>
          ) : (
            <>
              <path d="M12 3l7.5 3v5.5c0 4.6-3.1 7.9-7.5 9.5-4.4-1.6-7.5-4.9-7.5-9.5V6Z" />
              <path d="m9.2 12 2 2 3.6-3.8" />
            </>
          )}
        </svg>
        <h3>{feature.title}</h3>
        <p>{feature.copy}</p>
      </div>
    ))}
  </div>
</section>
