---
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import DownloadButton from '@/components/ui/DownloadButton.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguagePicker from '@/components/ui/LanguagePicker.astro';
import { defaultLang, localizePath, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  /** The home page: the header floats over the dark hero instead of pushing it down. */
  overHero?: boolean;
}

const { overHero = false } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

// Section links always carry the home path, so they also work from the
// privacy and terms pages (a bare "#faq" there points at nothing). On the home
// page "/#faq" is a same-document jump, not a reload.
const home = localizePath('/', lang);
const sections = [
  { id: 'top', label: t('header.navHome') },
  { id: 'como-funciona', label: t('header.navHow') },
  { id: 'funciones', label: t('header.navFeatures') },
  { id: 'faq', label: t('faq.title') },
];
const langSwitch = 'flex items-center gap-2.5 text-[13px] font-semibold tracking-[0.04em]';
const mobileLink =
  'transition-[color] duration-[180ms] ease-[ease] max-[1023px]:py-2.5 max-[1023px]:text-[15px] max-[1023px]:font-medium max-[1023px]:text-ink-soft max-[1023px]:hover:text-ink';
---

<!-- ══════════════ HEADER ══════════════ -->
<!-- The glass surface lives in `.site-header` in global.css, where the tokens
     and the specificity are controllable. The bar has no scroll styling: only
     its visibility changes, by sliding out of the top of the viewport when the
     visitor scrolls down and back in when they scroll up. -->
<!-- Over the hero the bar is fixed (out of flow, so the hero starts at the top
     of the page) and forced dark for as long as the hero is behind it, because
     it sits on the night sky. The script hands it back to the page theme once
     the hero has scrolled out from under it. -->
<header
  class:list={['site-header z-[60]', overHero ? 'fixed inset-x-0' : 'sticky']}
  data-hero={overHero ? '' : undefined}
  data-theme={overHero ? 'dark' : undefined}
>
  <div class="shell flex items-center gap-8 py-7 min-[1200px]:grid min-[1200px]:grid-cols-[1fr_auto_1fr] max-[1100px]:gap-5 max-[640px]:gap-4 max-[640px]:py-[18px]">
    <Logo />

    <!-- Glass pill; the link of the section in view gets aria-current and an
         orange dot (scroll-spy in the script below, home page only). -->
    <nav class="nav-pill max-[1023px]:hidden" aria-label={t('header.navAria')}>
      {sections.map((section) => (
        <a
          class="nav-pill-link"
          href={`${home}#${section.id}`}
          data-spy={overHero ? section.id : undefined}
        >
          {section.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-4 min-[1200px]:justify-self-end">
      <input
        type="checkbox"
        class="nav-toggle peer hidden max-[1023px]:grid max-[1023px]:h-11 max-[1023px]:w-11 max-[1023px]:cursor-pointer max-[1023px]:appearance-none max-[1023px]:place-items-center max-[1023px]:rounded-xl max-[1023px]:border max-[1023px]:border-border max-[1023px]:bg-card max-[1023px]:text-ink"
        id="nav-toggle"
        aria-label={t('header.openMenuAria')}
      />
      <nav
        class="hidden max-[1023px]:peer-checked:absolute max-[1023px]:peer-checked:inset-x-0 max-[1023px]:peer-checked:top-full max-[1023px]:peer-checked:flex max-[1023px]:peer-checked:flex-col max-[1023px]:peer-checked:gap-1 max-[1023px]:peer-checked:border-b max-[1023px]:peer-checked:border-border max-[1023px]:peer-checked:bg-surface max-[1023px]:peer-checked:pt-3.5 max-[1023px]:peer-checked:pr-5 max-[1023px]:peer-checked:pb-[22px] max-[1023px]:peer-checked:pl-5 max-[1023px]:peer-checked:shadow-soft"
        aria-label={t('header.mobileNavAria')}
      >
        {sections.map((section) => (
          <a class={mobileLink} href={`${home}#${section.id}`}>
            {section.label}
          </a>
        ))}
        <div class="flex items-center gap-4">
          <div class={langSwitch}>
            <LanguagePicker />
          </div>
          {!overHero && <ThemeToggle class="hidden max-[640px]:grid" />}
        </div>
      </nav>
      <LanguagePicker class="max-[1023px]:hidden" align="right" />
      <!-- No theme toggle over the hero: the hero is always dark, so on the home
           page the control would only ever change sections the visitor has not
           scrolled to. The OS preference still applies there. -->
      {!overHero && <ThemeToggle class="max-[640px]:hidden" />}
      <!-- From 1024px the adaptive "Descargar para Windows" with its icon fits;
           below that the bar already holds the logo, the burger and the CTA, so
           the short label stays (a 20-character label at 390px overflows). -->
      <span class="max-[1023px]:hidden">
        <DownloadButton compact href={`${home}#descargar`} />
      </span>
      <span class="min-[1024px]:hidden">
        <Button variant="primary" href={`${home}#descargar`}>
          {t('cta.download')}
        </Button>
      </span>
    </div>
  </div>
</header>

<script>
  // Client behaviour lives in src/scripts so it is bundled, versioned and
  // cacheable instead of re-shipped inline on every navigation.
  import '@/scripts/header-scroll';
</script>
