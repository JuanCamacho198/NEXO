---
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const faqs = [
  {
    q: t('faq.q1'),
    a: t('faq.a1'),
  },
  {
    q: t('faq.q2'),
    a: t('faq.a2'),
  },
  {
    q: t('faq.q3'),
    a: t('faq.a3'),
  },
  {
    q: t('faq.q4'),
    a: t('faq.a4'),
  },
] as const;
---

<!-- ══════════════ FAQ ══════════════ -->
<section id="faq" class="bg-surface-alt border-t border-t-border py-24 max-[640px]:py-16">
  <div class="shell grid grid-cols-[0.8fr_1.2fr] [align-items:start] gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-7">
    <h2 class="min-[640px]:text-[2.25rem]">{t('faq.title')}</h2>

    <div class="border-t border-t-border">
      {faqs.map((faq) => (
        <details class="faq-item border-b border-b-border py-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-medium text-ink [&::-webkit-details-marker]:hidden">
            {faq.q}
            <span class="faq-indicator" aria-hidden="true">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              >
                <path d="M5 12h14" />
                <path class="faq-plus" d="M12 5v14" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-[60ch] text-[0.95rem] leading-[1.7] text-ink-soft">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
