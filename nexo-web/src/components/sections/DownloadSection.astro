---
import PlatformIcon from '@/components/ui/PlatformIcon.astro';
import { formatSize, getDownloadCatalog, type Platform } from '@/lib/releases';
import { defaultLang, useTranslations, type Lang, type UIKey } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

/** Resolved exactly once. `null` means every asset lookup failed and the fallback renders. */
const catalog = await getDownloadCatalog();

const platformLabels: Record<Platform, UIKey> = {
  android: 'hero.platformAndroid',
  windows: 'hero.platformWindows',
  macos: 'hero.platformMacOS',
  linux: 'hero.platformLinux',
};

const ctaLabels: Record<Platform, UIKey> = {
  android: 'download.ctaAndroid',
  windows: 'download.ctaWindows',
  macos: 'download.ctaMacOS',
  linux: 'download.ctaLinux',
};

/** A card is only renderable with a primary asset; anything malformed is dropped. */
const offers = (catalog?.offers ?? []).filter((offer) =>
  Boolean(offer?.primary?.url && offer?.platform && offer?.version),
);
---

<!-- ══════════════ DOWNLOAD ══════════════ -->
<!-- The closing beat: dark like the rest of the home page, an orange glow
     rising behind the heading, and the visitor's own platform card first and
     lit (html[data-os] rules in global.css). -->
<section id="descargar" class="download relative text-ink" data-theme="dark">
  <div class="night-sky" aria-hidden="true"></div>
  <div class="download-glow" aria-hidden="true"></div>
  <div class="shell relative">
    <div class="download-head">
      <p class="download-eyebrow">{t('download.eyebrow')}</p>
      <h2 class="download-title">{t('cta.heading')}</h2>
      <p class="download-lead">{t('cta.lead')}</p>
    </div>

    {catalog && offers.length > 0 ? (
      <>
        <ul class="mt-14 grid grid-cols-4 gap-5 max-[1100px]:grid-cols-2 max-[640px]:grid-cols-1">
          {offers.map((offer) => (
            <li class="dl-card" data-platform={offer.platform}>
              <div class="dl-card-head">
                <PlatformIcon name={offer.platform} />
                <span class="dl-plat">{t(platformLabels[offer.platform])}</span>
                <span class="dl-badge">{t('download.recommended')}</span>
                <span class="dl-detected">{t('download.detected')}</span>
              </div>

              <ul class="dl-meta">
                <li class="dl-version">
                  <span>{t('download.versionLabel')}</span>
                  <span>{offer.version}</span>
                </li>
                <li class="dl-size">
                  <span>{t('download.sizeLabel')}</span>
                  <span>
                    {formatSize(offer.primary.sizeBytes)} {t('download.sizeUnit')}
                  </span>
                </li>
              </ul>

              <a class="dl-cta" href={offer.primary.url} rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M4 17.5V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {t(ctaLabels[offer.platform])}
              </a>

              {offer.alternates.length > 0 && (
                <details class="dl-alt">
                  <summary>{t('download.altVersions')}</summary>
                  <ul class="dl-alt-list">
                    {offer.alternates.map((alternate) => (
                      <li>
                        <a href={alternate.url} rel="noopener">
                          <span>{alternate.kind.toUpperCase()}</span>
                          <span>
                            {formatSize(alternate.sizeBytes)} {t('download.sizeUnit')}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}

              {offer.platform === 'android' && <p class="dl-note">{t('download.androidNote')}</p>}
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-wrap items-baseline justify-center gap-x-[22px] gap-y-[10px] text-[14px]">
          <a
            class="font-semibold text-ink underline underline-offset-[3px]"
            href="https://github.com/JuanCamacho198/NEXO/releases"
          >
            {t('download.allVersions')}
          </a>
          {catalog.checksumsUrl && (
            <p class="flex flex-wrap items-baseline gap-2 text-[13px] text-muted-foreground">
              <a
                class="font-semibold text-[oklch(80%_0.15_55)] underline underline-offset-[3px]"
                href={catalog.checksumsUrl}
              >
                {t('download.checksums')}
              </a>
              <span>{t('download.checksumsNote')}</span>
            </p>
          )}
        </div>
      </>
    ) : (
      <>
        <div class="dl-note mx-auto mt-[34px] grid max-w-[60ch] gap-1.5">
          <strong>{t('download.unavailable')}</strong>
          <span>{t('download.unavailableNote')}</span>
        </div>
        <div class="mt-10 flex flex-wrap items-baseline justify-center gap-x-[22px] gap-y-[10px] text-[14px]">
          <a
            class="font-semibold text-ink underline underline-offset-[3px]"
            href="https://github.com/JuanCamacho198/NEXO/releases"
          >
            {t('download.allVersions')}
          </a>
        </div>
      </>
    )}
  </div>
</section>

<style>
  .download {
    background: #0d0b18;
    padding: 120px 0 140px;
    overflow: clip;
  }
  /* A sunrise behind the heading: the same orange as the hero's ring. */
  .download-glow {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1100px, 120vw);
    height: 620px;
    /* Starts inside the section and fades out upward, so it never meets the
       FAQ above with a hard edge. */
    mask-image: linear-gradient(to bottom, transparent, black 35%);
    translate: -50% 0;
    background: radial-gradient(
      closest-side,
      oklch(72% 0.18 50 / 0.28),
      oklch(55% 0.14 285 / 0.12) 55%,
      transparent
    );
    filter: blur(20px);
    pointer-events: none;
  }
  .download-head {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .download-eyebrow {
    color: oklch(76% 0.16 55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .download-title {
    margin-top: 14px;
    font-size: clamp(2.4rem, 5.2vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    background: linear-gradient(
      100deg,
      oklch(97% 0.01 80),
      oklch(84% 0.08 60) 55%,
      oklch(72% 0.19 45)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .download-lead {
    margin-top: 18px;
    color: var(--color-ink-soft);
    font-size: 1.15rem;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .download {
      padding: 80px 0 96px;
    }
  }
</style>
