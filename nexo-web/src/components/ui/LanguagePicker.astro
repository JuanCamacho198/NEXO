---
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  class?: string;
  align?: 'left' | 'right';
}

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const { class: className = '', align = 'left' } = Astro.props;
---

<!-- Kept as <details>: its native toggle needs no JS, which the zero-JS baseline
     depends on. The `popover` attribute is not an option here — its user-agent
     style is `position: fixed; inset: 0; margin: auto`, which centres the panel
     on screen and needs CSS Anchor Positioning to anchor it back to the button,
     and that is not available in Firefox stable. -->
<details class={`lang-picker ${className}`}>
  <summary class="text-ink" aria-label={t('header.languageAria')}>
    {lang === 'en' ? 'EN' : 'ES'}
    <svg class="lang-chevron" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="m6 9 6 6 6-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </summary>
  <ul class={`lang-menu${align === 'right' ? ' lang-menu-right' : ''}`}>
    <li>
      <a href="/" aria-current={lang === 'es' ? 'true' : undefined}>
        ES
      </a>
    </li>
    <li>
      <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined}>
        EN
      </a>
    </li>
  </ul>
</details>
