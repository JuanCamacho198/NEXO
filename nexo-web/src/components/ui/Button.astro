---
interface Props {
  variant: "primary" | "outline" | "ghost";
  size?: "lg";
  href?: string;
  icon?: "download" | "play";
}

const { variant, size, href = "#", icon } = Astro.props;
const className = `pill ${variant === "primary" ? "pill-ink" : "pill-ghost"}${size === "lg" ? " pill-lg" : ""}`;
---
<a class={className} href={href}>
  {icon === "download" ? (
    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M4 17.5V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  ) : icon === "play" ? (
    <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M10 8.7v6.6L15.3 12Z" fill="currentColor"/></svg>
  ) : null}
  <slot />
</a>
