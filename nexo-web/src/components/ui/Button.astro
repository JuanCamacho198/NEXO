---
interface Props {
  variant: 'primary' | 'outline' | 'ghost';
  size?: 'lg';
  href?: string;
  icon?: 'download' | 'play';
}

const { variant, size, href = '#', icon } = Astro.props;

const base =
  'inline-flex cursor-pointer items-center justify-center gap-2 rounded-[999px] border font-sans font-semibold transition-[background-color,border-color,color,translate,box-shadow] duration-[180ms] ease-[ease] active:translate-y-px';
const tone =
  variant === 'primary'
    ? 'btn-primary border-transparent bg-ink text-[oklch(98.6%_0.004_95)] hover:bg-[oklch(28%_0.055_264)] hover:shadow-soft'
    : 'border-border bg-card text-ink hover:border-ink-soft';
const dimensions =
  size === 'lg'
    ? 'px-7 py-[15px] text-[15.5px] leading-none'
    : 'px-5 py-[11px] text-[14.5px] leading-none';
const className = `${base} ${tone} ${dimensions}`;
---

<a class={className} href={href}>
  {icon === 'download' ? (
    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M4 17.5V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  ) : icon === 'play' ? (
    <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7" />
      <path d="M10 8.7v6.6L15.3 12Z" fill="currentColor" />
    </svg>
  ) : null}
  <slot />
</a>
