---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<div class:list={["app-shelf", className]}>
  <div class="cover c-habitos"><span>Hábitos atómicos</span></div>
  <div class="cover c-1984"><span>1984</span></div>
  <div class="cover c-principito"><span>El principito</span></div>
  <div class="cover c-odisea"><span>La Odisea</span></div>
  <div class="cover c-crimen"><span>Crimen y castigo</span></div>
  <div class="cover c-dune"><span>DUNE</span></div>
</div>
