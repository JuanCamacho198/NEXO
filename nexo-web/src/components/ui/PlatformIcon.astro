---
interface Props {
  name: "android" | "windows" | "macos" | "linux";
}

const { name } = Astro.props;
---
<span class="grid h-[22px] w-[22px] place-items-center text-ink transition-transform duration-[180ms] ease-[ease] hover:-translate-y-0.5 [&>svg]:h-[22px] [&>svg]:w-[22px]">{name === "android" ? (
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.2 9.4h11.6v7.2a1.4 1.4 0 0 1-1.4 1.4H7.6a1.4 1.4 0 0 1-1.4-1.4Zm-.9 0a5.8 5.8 0 0 1 11.8 0M8.4 6.2l-1-1.6m8.2 1.6 1-1.6M9.4 8.6h.01m5.19 0h.01" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><rect x="8.2" y="10.2" width="1.6" height="2.6" rx=".8" fill="currentColor"/><rect x="14.2" y="10.2" width="1.6" height="2.6" rx=".8" fill="currentColor"/></svg>
) : name === "windows" ? (
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.4 10.6 5.5v6H4Zm7.4-1L20 4.2v7.3h-8.6ZM4 12.3h6.6v6L4 17.6Zm7.4 0H20v7.3l-8.6-1.3Z" fill="currentColor"/></svg>
) : name === "macos" ? (
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.7 12.6c0-2 1.6-3 1.7-3.1-.9-1.4-2.4-1.5-2.9-1.6-1.2-.1-2.4.7-3 .7-.6 0-1.6-.7-2.6-.7-1.3 0-2.6.8-3.3 2-1.4 2.4-.4 6 1 8 .7 1 1.5 2.1 2.5 2 1-.1 1.4-.7 2.6-.7s1.6.7 2.6.6c1.1 0 1.8-1 2.4-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.1-.8-2.1-3.6ZM14.9 6.7c.5-.7.9-1.6.8-2.6-.8 0-1.8.5-2.4 1.2-.5.6-1 1.6-.8 2.5.9.1 1.8-.4 2.4-1.1Z" fill="currentColor"/></svg>
) : (
  <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="13.6" rx="5" ry="6.2" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="7.2" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="10.9" cy="6.7" r=".9" fill="currentColor"/><circle cx="13.1" cy="6.7" r=".9" fill="currentColor"/><path d="M11 8.7h2l-1 1.3Z" fill="currentColor"/><ellipse cx="12" cy="15.4" rx="2.6" ry="3.2" fill="currentColor" opacity=".35"/></svg>
)}</span>
