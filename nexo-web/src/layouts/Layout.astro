---
import '@/styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalEs?: string;
  canonicalEn?: string;
  /** Above-the-fold image the browser should start fetching before it parses
   *  the markup. Only the landing passes one. */
  preloadImage?: { srcset: string; sizes: string };
}

const {
  title,
  description,
  lang,
  canonicalEs = '/',
  canonicalEn = '/en/',
  preloadImage,
} = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // The one script that must stay inline, and the documented exception to
      // the zero-JS rule: a stored or OS-preferred colour scheme has to land on
      // <html> before the first paint or the page flashes the wrong theme. A
      // deferred module runs too late for that. Every other script lives in
      // src/scripts and ships as a cacheable chunk.
      (function () {
        try {
          var stored = localStorage.getItem('nexo-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (error) {
          // Storage unavailable (private mode / blocked): fall through to light.
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1624" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    {Astro.site && (
      <>
        <link
          rel="canonical"
          href={new URL(lang === 'en' ? canonicalEn : canonicalEs, Astro.site)}
        />
        <link rel="alternate" hreflang="es" href={new URL(canonicalEs, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(canonicalEn, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(canonicalEs, Astro.site)} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* The hero sky is the LCP image on the landing. Astro cannot hoist a
        preload for an asset it only meets deep inside a component, so the
        landing page passes its own preload; every other page omits it.
        imagesrcset/imagesizes must mirror the <Picture> exactly or the browser
        downloads a second, mismatched candidate. */}
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}
    {/* Inter's latin subset, discovered through global.css otherwise. Preloading
        it removes one request from the critical chain: the CSS has to parse
        before the @font-face url is even known. Hashed by Vite so it can be
        cached for a year. */}
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#top">
      {t('header.skipLink')}
    </a>
    <slot />
    <script>
      import '@/scripts/layout-client';
    </script>
  </body>
</html>
