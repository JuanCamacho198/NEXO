---
import '@/styles/global.css';
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    {Astro.site && (
      <>
        <link rel="alternate" hreflang="es" href={new URL('/', Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#top">
      {t('header.skipLink')}
    </a>
    <slot />
  </body>
</html>
