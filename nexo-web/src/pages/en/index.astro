---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import HomeSections from '@/components/sections/HomeSections.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import { defaultLang, useTranslations, type Lang } from '@/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<Layout lang="en" title={t('meta.title')} description={t('hero.lead')}>
  <SiteHeader />

  <HomeSections />

  <SiteFooter />
</Layout>
