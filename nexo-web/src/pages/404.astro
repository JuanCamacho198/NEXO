---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { defaultLang, useTranslations, type Lang } from "../i18n/utils";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<Layout
  lang="es"
  title={t("notfound.metaTitle")}
  description={t("notfound.description")}
>
  <main id="top" class="py-24 max-[640px]:py-16" style="min-height: 70vh; display: grid; place-items: center; text-align: center;">
    <div class="shell">
      <h1>{t("notfound.heading")}</h1>
      <p class="mt-5 max-w-[46ch] text-[1.05rem] leading-[1.75] text-ink-soft text-pretty">{t("notfound.description")}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3.5 max-[640px]:gap-3" style="justify-content: center;">
        <Button variant="primary" href="/">{t("notfound.backHome")}</Button>
      </div>
    </div>
  </main>
</Layout>
