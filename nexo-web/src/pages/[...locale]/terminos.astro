---
import Layout from '@/layouts/Layout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import { defaultLang, localeStaticPaths, useTranslations, type Lang } from '@/i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const sections = [
  { title: t('terms.s1Title'), body: t('terms.s1Body') },
  { title: t('terms.s2Title'), body: t('terms.s2Body') },
  { title: t('terms.s3Title'), body: t('terms.s3Body') },
  { title: t('terms.s4Title'), body: t('terms.s4Body') },
  { title: t('terms.s5Title'), body: t('terms.s5Body') },
  { title: t('terms.s6Title'), body: t('terms.s6Body') },
  { title: t('terms.s7Title'), body: t('terms.s7Body') },
  { title: t('terms.s8Title'), body: t('terms.s8Body') },
] as const;

const email = t('terms.contactEmail');
---

<Layout
  lang={lang}
  title={t('terms.metaTitle')}
  description={t('terms.lead')}
  canonicalEs="/terminos"
  canonicalEn="/en/terminos"
>
  <SiteHeader />

  <main id="top" class="py-24 max-[640px]:py-16">
    <div class="shell max-w-[68ch]">
      <Eyebrow>{t('terms.eyebrow')}</Eyebrow>
      <h1>{t('terms.heading')}</h1>
      <p class="mt-5 text-[1.05rem] leading-[1.75] text-ink-soft text-pretty">{t('terms.lead')}</p>

      {sections.map((section) => (
        <section class="mt-12">
          <h2>{section.title}</h2>
          <p class="mt-3 leading-[1.75] text-ink-soft">{section.body}</p>
        </section>
      ))}

      <section class="mt-12">
        <h2>{t('terms.s9Title')}</h2>
        <p class="mt-3 leading-[1.75] text-ink-soft">{t('terms.s9Body')}</p>
        <p class="mt-3 leading-[1.75] text-ink-soft">
          <a class="underline underline-offset-4" href={`mailto:${email}`}>
            {email}
          </a>
        </p>
      </section>

      <p class="mt-12 text-[0.95rem] leading-[1.7] text-ink-soft">
        {t('terms.updatedOn')} {t('terms.effectiveDate')}
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
