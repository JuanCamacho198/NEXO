---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import HomeSections from '@/components/sections/HomeSections.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import { defaultLang, localeStaticPaths, useTranslations, type Lang } from '@/i18n/utils';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('meta.title')} description={t('hero.lead')}>
  <!-- .hero-intro scopes the load timeline in global.css; it wraps the header
       too because the nav is the timeline's last beat. -->
  <div class="hero-intro">
    <SiteHeader overHero />

    <HomeSections />

    <SiteFooter dark />
  </div>
</Layout>
